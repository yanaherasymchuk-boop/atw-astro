---
import { navigation } from "../../data/navigation";
import { site } from "../../data/site";
import MobileNav from "./MobileNav.astro";
---

<header class="site-header">
  <div class="container-wide header-inner">
    <a class="brand" href="/">
      {site.shortName}
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
  <ul>
    {navigation.map((item) => (
      <li class:list={["nav-item", { "has-children": item.children }]}>
        {item.children ? (
          <>
            <a class="nav-link" href={item.href}>
              {item.label}
              <span class="nav-chevron" aria-hidden="true">⌄</span>
            </a>

            <div class="desktop-dropdown">
              <div class="dropdown-inner">
                {item.children.map((child) => (
                  <a class="dropdown-link" href={child.href}>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </>
        ) : (
          <a class="nav-link" href={item.href}>
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>
<a class="header-phone" href={site.phoneHref}>
  {site.phoneDisplay}
</a>
    <a class="header-cta" href={site.bookingUrl}>
      Book Now
    </a>
    <MobileNav />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: rgba(7, 8, 20, 0.92);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    font-weight: 900;
    white-space: nowrap;
  }
.header-phone {
  color: var(--color-text-muted);
  font-size: 13px;
  font-weight: 800;
  white-space: nowrap;
}

.header-phone:hover {
  color: var(--color-cyan);
}

@media (max-width: 1180px) {
  .header-phone {
    display: none;
  }
}
  .desktop-nav {
    margin-left: auto;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

.nav-item {
  position: relative;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 5px;

  color: var(--color-text-muted);
  font-size: 14px;
  font-weight: 800;

  transition:
    color var(--transition-fast),
    transform var(--transition-fast);
}

.nav-link:hover {
  color: var(--color-text);
}

.nav-chevron {
  color: var(--color-cyan);
  font-size: 13px;
  line-height: 1;
  transition: transform var(--transition-fast);
}

.has-children:hover .nav-chevron,
.has-children:focus-within .nav-chevron {
  transform: rotate(180deg);
}
.desktop-dropdown {
  position: absolute;
  top: calc(100% + 12px);
  left: 50%;

  width: 280px;

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translate(-50%, -8px);

  z-index: 200;

  transition:
    opacity var(--transition-fast),
    transform var(--transition-fast),
    visibility var(--transition-fast);
}

.desktop-dropdown::before {
  content: "";
  position: absolute;
  top: -18px;
  left: 0;
  width: 100%;
  height: 28px;
}

.dropdown-inner {
  display: flex;
  flex-direction: column;
  gap: 2px;

  padding: 10px;

  border: 1px solid var(--color-border);
  border-radius: 18px;

  background:
    radial-gradient(
      circle at 90% 0%,
      rgba(121, 87, 255, 0.15),
      transparent 45%
    ),
    rgba(11, 12, 27, 0.98);

  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);

  backdrop-filter: blur(18px);
}

.dropdown-link {
  display: block;

  width: 100%;

  padding: 11px 13px;

  border-radius: 10px;

  color: var(--color-text-muted);

  font-size: 14px;
  font-weight: 800;
  line-height: 1.35;

  white-space: normal;

  transition:
    color var(--transition-fast),
    background var(--transition-fast),
    transform var(--transition-fast);
}

.dropdown-link:hover,
.dropdown-link:focus-visible {
  color: var(--color-text);
  background: rgba(8, 215, 223, 0.07);
  transform: translateX(3px);
}

.has-children:hover .desktop-dropdown,
.has-children:focus-within .desktop-dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translate(-50%, 0);
}
.header-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 42px;
  padding: 0 20px;

  border-radius: 999px;

  background: linear-gradient(
    135deg,
    #08d7df 0%,
    #168cff 55%,
    #7457ff 100%
  );

  color: #ffffff;
  font-size: 14px;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;

  box-shadow:
    0 8px 24px rgba(8, 215, 223, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);

  transition:
    transform var(--transition-fast),
    box-shadow var(--transition-fast),
    filter var(--transition-fast);
}

.header-cta:hover {
  color: #ffffff;
  transform: translateY(-1px);

  box-shadow:
    0 12px 30px rgba(8, 215, 223, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.22);

  filter: brightness(1.06);
}

.header-cta:focus-visible {
  outline: 2px solid var(--color-cyan);
  outline-offset: 3px;
}
  @media (max-width: 980px) {
  .desktop-nav,
  .header-cta,
  .header-phone {
    display: none;
  }
}
</style>