---
import { site } from "../../data/site";
const smsHref = site.phoneHref.replace("tel:", "sms:");
---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label={`${site.shortName} home`}>
        <img
          src="/media/global/footer-emblem.webp"
          alt={site.name}
          width="700"
          height="700"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>Mobile Detailing Service in Bonney Lake, WA</p>

      <div class="footer-actions">
        <a class="footer-action footer-action-secondary" href={smsHref}>
          Text Us
        </a>
        <a class="footer-action footer-action-primary" href={site.bookingUrl}>
          Book Now
        </a>
      </div>
    </div>

    <div class="footer-column">
      <span class="footer-title">Explore</span>

      <a href="/">Home</a>
      <a href="/services/">Services</a>
      <a href="/about-us-atw-detailing/">Our Story</a>
      <a href="/blog/">Blog</a>
      <a href="/contact-us/">Contact</a>
    </div>

    <div class="footer-column">
      <span class="footer-title">Contact</span>

      <a href={site.phoneHref}>
        {site.phoneDisplay}
      </a>

      <a href={`mailto:${site.email}`}>
        {site.email}
      </a>

      <span>{site.location}</span>
    </div>
  </div>

  <div class="container-wide footer-bottom">
    <span>© 2026 {site.name}</span>
    <a href="/service-policies/">Service Policies</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);

    background:
      radial-gradient(
        circle at 15% 0%,
        rgba(8, 215, 223, 0.07),
        transparent 30%
      ),
      var(--color-bg);
  }

 .footer-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.65fr 1fr;
  align-items: start;
  gap: 44px;

  padding-top: 42px;
  padding-bottom: 34px;
}

  .footer-logo {
    display: inline-flex;
    align-items: center;
  }

  .footer-logo img {
  display: block;
  width: 150px;
  height: 150px;
  object-fit: contain;
}

  .footer-brand p {
  max-width: 360px;
  margin: 8px 0 0;

  color: var(--color-text-muted);
  font-size: 14px;
  line-height: 1.55;
}

  .footer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.footer-action {
  min-height: 38px;
  padding: 0 16px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border-radius: 999px;

  font-size: 13px;
  font-weight: 900;
  line-height: 1;

  transition:
    transform var(--transition-fast),
    border-color var(--transition-fast),
    background var(--transition-fast),
    filter var(--transition-fast);
}

.footer-action:hover {
  transform: translateY(-1px);
}

.footer-action-secondary {
  border: 1px solid rgba(8, 215, 223, 0.42);
  background: rgba(8, 215, 223, 0.055);
  color: var(--color-cyan);
}

.footer-action-secondary:hover {
  border-color: rgba(8, 215, 223, 0.8);
  background: rgba(8, 215, 223, 0.11);
}

.footer-action-primary {
  border: 1px solid transparent;
  background: linear-gradient(135deg,#08d7df,#168cff 55%,#7457ff);
  color: #fff;
}

.footer-action-primary:hover {
  color: #fff;
  filter: brightness(1.06);
}

.footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;

    color: var(--color-text-muted);
    font-size: 14px;
  }
  .footer-column a {
  display: block;

  color: var(--color-text-muted);

  transition:
    color var(--transition-fast),
    transform var(--transition-fast);
}

  .footer-title {
    margin-bottom: 6px;

    color: var(--color-text);
    font-weight: 900;
  }

  .footer-column a {
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .footer-column a:hover {
    color: var(--color-cyan);
    transform: translateX(2px);
  }

  .footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;

  padding-top: 16px;
  padding-bottom: 18px;

  border-top: 1px solid var(--color-border);

  color: var(--color-text-soft);
  font-size: 12px;
}

.footer-bottom a {
  color: var(--color-text-soft);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.footer-bottom a:hover {
  color: var(--color-cyan);
}

@media (max-width: 520px) {
  .footer-bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }
}

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 34px;

      padding-top: 52px;
      padding-bottom: 40px;
    }
    @media (max-width: 900px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .footer-brand {
    grid-column: 1 / -1;
  }
}

@media (max-width: 600px) {
  .footer-logo img {
    width: 140px;
    height: 140px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .footer-brand {
    grid-column: auto;
  }
}
  }
</style>