---
import { site } from "../../data/site";
---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <strong>{site.name}</strong>
      <p>Mobile Detailing Service in Bonney Lake, WA</p>
    </div>

    <div class="footer-column">
      <span class="footer-title">Explore</span>

      <a href="/">Home</a>
      <a href="/services/">Services</a>
      <a href="/about-us-atw-detailing/">Our Story</a>
      <a href="/blog/">Blog</a>
      <a href="/contact-us/">Contact</a>
    </div>

    <div class="footer-column">
      <span class="footer-title">Contact</span>

      <a href={site.phoneHref}>
        {site.phoneDisplay}
      </a>

      <a href={`mailto:${site.email}`}>
        {site.email}
      </a>

      <span>{site.location}</span>
    </div>
  </div>

  <div class="container-wide footer-bottom">
    © 2026 {site.name}
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);

    background:
      radial-gradient(
        circle at 15% 0%,
        rgba(8, 215, 223, 0.07),
        transparent 30%
      ),
      var(--color-bg);
  }

 .footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr 1fr;
  gap: 48px;

  padding-top: 64px;
  padding-bottom: 52px;
}

  .footer-brand strong {
    display: block;

    color: var(--color-text);
    font-size: 20px;
    font-weight: 900;
  }

  .footer-brand p {
    max-width: 420px;
    margin: 10px 0 0;

    color: var(--color-text-muted);
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;

    color: var(--color-text-muted);
    font-size: 14px;
  }
  .footer-column a {
  display: block;

  color: var(--color-text-muted);

  transition:
    color var(--transition-fast),
    transform var(--transition-fast);
}

  .footer-title {
    margin-bottom: 6px;

    color: var(--color-text);
    font-weight: 900;
  }

  .footer-column a {
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .footer-column a:hover {
    color: var(--color-cyan);
    transform: translateX(2px);
  }

  .footer-bottom {
    padding-top: 20px;
    padding-bottom: 26px;

    border-top: 1px solid var(--color-border);

    color: var(--color-text-soft);
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 34px;

      padding-top: 52px;
      padding-bottom: 40px;
    }
    @media (max-width: 900px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .footer-brand {
    grid-column: 1 / -1;
  }
}

@media (max-width: 600px) {
  .footer-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .footer-brand {
    grid-column: auto;
  }
}
  }
</style>