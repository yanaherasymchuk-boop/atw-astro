<div class="gift-background" aria-hidden="true">
  <div class="gift-orb gift-orb-1"></div>
  <div class="gift-orb gift-orb-2"></div>
  <div class="gift-orb gift-orb-3"></div>
  <div class="gift-grid-layer"></div>
  <div class="gift-fireworks" id="giftFireworks"></div>
</div>

<script is:inline>
  (() => {
    const layer = document.getElementById("giftFireworks");
    if (!layer) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) return;

    const colors = [
      "#0ad2d9",
      "#22a7ff",
      "#9b5de5",
      "#e31b96",
      "#b629e7"
    ];

    function createFirework() {
      const firework = document.createElement("span");
      firework.className = "gift-firework";

      const x = 8 + Math.random() * 84;
      const y = 6 + Math.random() * 52;

      firework.style.left = `${x}%`;
      firework.style.top = `${y}%`;
      firework.style.color =
        colors[Math.floor(Math.random() * colors.length)];

      const count = 10;

      for (let i = 0; i < count; i++) {
        const particle = document.createElement("i");
        particle.style.setProperty(
          "--angle",
          `${(360 / count) * i}deg`
        );
        particle.style.setProperty(
          "--distance",
          `${52 + Math.random() * 30}px`
        );
        firework.appendChild(particle);
      }

      layer.appendChild(firework);

      window.setTimeout(() => {
        firework.remove();
      }, 1500);
    }

    function burst() {
      createFirework();

      window.setTimeout(createFirework, 260);

      if (Math.random() > 0.45) {
        window.setTimeout(createFirework, 520);
      }
    }

    let timeoutId;

    function schedule() {
      timeoutId = window.setTimeout(() => {
        burst();
        schedule();
      }, 2600 + Math.random() * 1800);
    }

    window.setTimeout(burst, 600);
    schedule();

    window.addEventListener(
      "pagehide",
      () => window.clearTimeout(timeoutId),
      { once: true }
    );
  })();
</script>
