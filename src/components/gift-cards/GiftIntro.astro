---
import { site } from "../../data/site";
---

<section class="gift-intro-wrap">
  <div class="gift-intro">
    <div class="gift-visual" data-reveal="left" aria-label="ATW Detailing gift card illustration">
      <div class="gift-logo">
        <strong>ATW</strong>
        <span>Detailing &amp; Paint Correction</span>
      </div>

      <div class="gift-card-title">
        <h2>GIFT CARD</h2>
        <p>Mobile Detailing &amp; Paint Correction</p>
      </div>
    </div>

    <div class="gift-copy" data-reveal="right">
      <h2>A Gift They'll <em>Actually Use</em></h2>

      <p>
        You don't need to know which detailing package they need or what size
        vehicle they drive. Choose the gift card amount and let them decide how
        they'd like to use it.
      </p>

      <p>
        ATW eGift Cards can be applied toward our mobile detailing and paint
        correction services.
      </p>

      <ul class="gift-checklist">
        <li>Choose the amount that works for you</li>
        <li>Select a card design for the occasion</li>
        <li>Send it directly to the recipient</li>
        <li>Recipient chooses the service they want</li>
        <li>Mobile service — we come to them</li>
      </ul>

      <a
        class="gift-btn"
        href={site.giftCardUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Choose a Gift Card »
      </a>
    </div>
  </div>
</section>
