---
import { site } from "../../data/site";
---

<section class="gift-cta">
  <div data-reveal="up">
    <h2>Give Them a <span>Fresh Start.</span></h2>

    <p>
      Choose an ATW Detailing eGift Card, select the amount, and send it
      directly to someone you care about.
    </p>

    <div class="gift-btn-row">
      <a
        class="gift-btn"
        href={site.giftCardUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Buy an eGift Card »
      </a>
    </div>
  </div>
</section>
