---
import { site } from "../../data/site";
---

<section class="gift-hero">
  <div class="gift-hero-glow" aria-hidden="true"></div>

  <div class="gift-hero-inner">
    <div class="gift-badge">ATW Detailing eGift Cards</div>

    <h1>
      Give the Gift of a
      <br />
      <span>Clean Car</span>
    </h1>

    <p class="gift-hero-sub">
      Choose any amount, pick a design, and send an ATW Detailing eGift Card
      directly by email or text.
    </p>

    <div class="gift-btn-row">
      <a
        class="gift-btn"
        href={site.giftCardUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Buy a Gift Card »
      </a>
    </div>
  </div>
</section>

<div class="gift-trust" aria-label="Gift card benefits">
  <div class="gift-trust-item">Choose your own amount</div>
  <div class="gift-trust-item">Send by email or text</div>
  <div class="gift-trust-item">Multiple card designs</div>
  <div class="gift-trust-item">Use toward any ATW service</div>
</div>
