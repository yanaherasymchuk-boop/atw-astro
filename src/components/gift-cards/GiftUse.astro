---
import { site } from "../../data/site";
---

<section class="gift-use">
  <div class="gift-use-inner" data-reveal="up">
    <h2>
      They Choose the Service.
      <br />
      <em>We Come to Them.</em>
    </h2>

    <p>
      The recipient can use their gift card toward ATW Detailing services and
      schedule mobile service at a convenient time. No need to guess which
      detailing package they would prefer.
    </p>

    <a
      class="gift-btn gift-btn-outline"
      href={site.giftCardUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      View Gift Cards »
    </a>
  </div>
</section>
