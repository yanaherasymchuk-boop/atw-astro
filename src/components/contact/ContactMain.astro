---
import { site } from "../../data/site";
---

<div id="atw-cp">
  <canvas id="atw-cp-canvas" aria-hidden="true"></canvas>

  <div class="atw-cp-shell">
    <section class="atw-cp-hero">
      <div class="atw-cp-hero-copy" data-reveal="left">
        <div class="atw-cp-kicker">Mobile Detailing · Bonney Lake, WA</div>
        <h1 class="atw-cp-title">
          <span>Contact</span>
          <span class="atw-cp-gradient">ATW Detailing</span>
        </h1>
        <p class="atw-cp-subtitle">
          Text, call, book online, or send us a message. For a quick pricing estimate, use the calculator. For custom work, commercial vehicles, or questions about an existing appointment, contact us directly.
        </p>

        <div class="atw-cp-actions">
          <a class="atw-cp-btn atw-cp-btn-primary" href="sms:+12533867243">Text Us</a>
          <a class="atw-cp-btn atw-cp-btn-outline" href={site.bookingUrl} target="_blank" rel="noopener">Book Online</a>
          <a class="atw-cp-btn atw-cp-btn-outline" href="/mobile-detailing-price-estimate/">Price Estimate</a>
        </div>

        <div class="atw-cp-hero-links">
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span>Mobile service only</span>
        </div>
      </div>

      <div class="atw-cp-hero-visual" data-reveal="right">
        <div class="atw-cp-video-wrap">
          <video autoplay muted loop playsinline preload="metadata">
            <source src="/media/contact/contact-hero.mp4" type="video/mp4">
          </video>
          <div class="atw-cp-video-tag">
            <strong>We come to you.</strong>
            Home, workplace, fleet lot, or another approved location inside our service area.
          </div>
        </div>
      </div>
    </section>
  </div>

  <nav class="atw-cp-contact-rail" data-reveal="up" aria-label="Contact options">
    <a class="atw-cp-contact-link" href="sms:+12533867243">
      <small>Quick questions</small>
      <strong>Text Us</strong>
      <span>Photos, details, appointment questions</span>
    </a>
    <a class="atw-cp-contact-link" href={site.phoneHref}>
      <small>Call directly</small>
      <strong>{site.phoneDisplay}</strong>
      <span>Talk through the service you need</span>
    </a>
    <a class="atw-cp-contact-link" href={`mailto:${site.email}`}>
      <small>Email</small>
      <strong>Send a Message</strong>
      <span>Commercial, fleet, and general inquiries</span>
    </a>
    <a class="atw-cp-contact-link" href={site.bookingUrl} target="_blank" rel="noopener">
      <small>Choose a time</small>
      <strong>Book Online</strong>
      <span>View available appointment times</span>
    </a>
  </nav>

  <section class="atw-cp-message-section">
    <div class="atw-cp-shell">
      <div class="atw-cp-kicker" data-reveal="up">Send a Message</div>
      <h2 class="atw-cp-section-title" data-reveal="up">Tell Us What You <span class="atw-cp-gradient-text">Need</span></h2>
      <p class="atw-cp-section-copy" data-reveal="up">
        Use the form for general questions, appointment changes, gift cards, commercial work, or anything that does not fit the standard online booking flow.
      </p>

      <div class="atw-cp-message-grid">
        <div class="atw-cp-form-panel" data-reveal="up">
          <div class="atw-cp-form-head">
            <h3>Contact Form</h3>
            <p>No payment is required. We will reply with the next step.</p>
          </div>
          
          <form id="atw-contact-form" class="atw-cp-form" novalidate>
            <input class="atw-cp-hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true">
            <input type="hidden" name="startedAt" id="atw-contact-started-at">

            <div class="atw-cp-field">
              <label for="contact-request-type">What can we help with?</label>
              <select id="contact-request-type" name="requestType" required>
                <option value="appointment">Request an Appointment</option>
                <option value="question">Ask a Question</option>
                <option value="commercial">Commercial or Fleet</option>
              </select>
            </div>

            <div class="atw-cp-form-note" id="appointment-note">
              Requested dates and times are not automatically booked. We’ll confirm availability with you.
            </div>

            <div class="atw-cp-field">
              <label for="contact-name">First Name</label>
              <input id="contact-name" name="name" type="text" autocomplete="given-name" maxlength="80" required>
            </div>

            <div class="atw-cp-field">
              <label for="contact-phone">Phone</label>
              <input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" required>
            </div>

            <div class="atw-cp-field">
              <label for="contact-email">Email</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="160" required>
            </div>

            <div id="appointment-fields" class="atw-cp-conditional">
              <div class="atw-cp-field">
                <label for="contact-vehicle">Year / Make / Model</label>
                <input
                  id="contact-vehicle"
                  name="vehicle"
                  type="text"
                  maxlength="150"
                  placeholder="2022 Toyota RAV4"
                >
              </div>

              <div class="atw-cp-field">
                <label for="contact-service">Service</label>
                <select id="contact-service" name="service">
                  <option value="">Select a service</option>
                  <option value="Interior Detail">Interior Detail</option>
                  <option value="Exterior Detail">Exterior Detail</option>
                  <option value="Full Detail">Full Detail</option>
                  <option value="Paint Correction / Polishing">Paint Correction / Polishing</option>
                  <option value="Ceramic Coating">Ceramic Coating</option>
                  <option value="Other / Not Sure">Other / Not Sure</option>
                </select>
              </div>

              <div class="atw-cp-field">
                <label for="contact-city-zip">City or ZIP Code</label>
                <input
                  id="contact-city-zip"
                  name="cityZip"
                  type="text"
                  autocomplete="postal-code"
                  maxlength="120"
                  placeholder="Bonney Lake, WA 98391"
                >
              </div>

              <div class="atw-cp-form-row">
                <div class="atw-cp-field">
                  <label for="contact-preferred-date">Preferred Date</label>
                  <input id="contact-preferred-date" name="preferredDate" type="date">
                </div>

                <div class="atw-cp-field">
                  <label for="contact-preferred-time">Preferred Time</label>
                  <select id="contact-preferred-time" name="preferredTime">
                    <option value="">Select</option>
                    <option value="Morning">Morning</option>
                    <option value="Midday">Midday</option>
                    <option value="Afternoon">Afternoon</option>
                    <option value="Flexible">Flexible</option>
                  </select>
                </div>
              </div>

              <div class="atw-cp-field">
                <label for="contact-second-date">Second Choice Date <span>Optional</span></label>
                <input id="contact-second-date" name="secondDate" type="date">
              </div>
            </div>

            <div id="commercial-fields" class="atw-cp-conditional" hidden>
              <div class="atw-cp-field">
                <label for="contact-company-name">Company Name</label>
                <input id="contact-company-name" name="companyName" type="text" maxlength="150">
              </div>

              <div class="atw-cp-field">
                <label for="contact-vehicle-count">Approximate Number of Vehicles <span>Optional</span></label>
                <input id="contact-vehicle-count" name="vehicleCount" type="text" maxlength="50" placeholder="e.g. 8 vehicles">
              </div>
            </div>

            <div class="atw-cp-field">
              <label for="contact-message" id="contact-message-label">Notes <span>Optional</span></label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                maxlength="3000"
                placeholder="Anything we should know about the vehicle or service?"
              ></textarea>
            </div>

            <button type="submit" class="atw-cp-submit">Request Appointment</button>
            <p id="atw-contact-status" class="atw-cp-form-status" role="status" aria-live="polite"></p>
          </form>

        </div>

        <aside class="atw-cp-info-column">
          <div class="atw-cp-hours" data-reveal="up">
            <h3>Business Hours</h3>
            <div class="atw-cp-hours-row"><span>Monday–Friday</span><span>8:00 AM–6:00 PM</span></div>
            <div class="atw-cp-hours-row"><span>Saturday–Sunday</span><span>9:00 AM–5:00 PM</span></div>
          </div>

          <div class="atw-cp-info-card" data-reveal="up">
            <h3>Mobile Service</h3>
            <p>ATW Detailing is mobile only. We travel to homes, workplaces, fleet lots, and approved parking locations throughout our service area.</p>
            <a class="atw-cp-inline-link" href="#atw-cp-service-area">View Service Area →</a>
          </div>

          <div class="atw-cp-info-card orange" data-reveal="up">
            <h3>Commercial & Fleet</h3>
            <p>For recurring service, multiple vehicles, work vans, box trucks, or semi cabs, contact us directly for a custom plan.</p>
            <a class="atw-cp-inline-link" href={`mailto:${site.email}?subject=Commercial%20or%20Fleet%20Inquiry`}>Send a Fleet Inquiry →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="atw-cp-area-section" id="atw-cp-service-area">
    <div class="atw-cp-shell">
      <div class="atw-cp-kicker" data-reveal="up">Service Area</div>
      <h2 class="atw-cp-section-title" data-reveal="up">We Come to You <span class="atw-cp-gradient-text">Across the South Sound</span></h2>
      <p class="atw-cp-section-copy" data-reveal="up">
        We are based in Bonney Lake and keep our routes focused so appointments stay practical and reliable. Check the map and city list below, or text us to confirm your exact address.
      </p>

      <div class="atw-cp-area-grid">
        <div class="atw-cp-map-frame" data-reveal="up">
          <img src="/media/contact/service-area.webp" alt="ATW Detailing mobile service area around Bonney Lake, Puyallup, Tacoma, Auburn, Kent, Enumclaw and surrounding cities" loading="lazy" decoding="async">
        </div>

        <div class="atw-cp-city-side" data-reveal="up">
          <p class="atw-cp-city-copy">
            Our regular mobile detailing area includes the following communities. Individual city pages can be linked here later without rebuilding the section.
          </p>

          <div class="atw-cp-city-list">
            <a class="atw-cp-city" href="/bonney-lake-car-detailing/">Bonney Lake</a>
            <span class="atw-cp-city">Lake Tapps</span>
            <a class="atw-cp-city" href="/puyallup-car-detailing/">Puyallup</a>
            <span class="atw-cp-city">South Hill</span>
            <span class="atw-cp-city">Sumner</span>
            <span class="atw-cp-city">Auburn</span>
            <span class="atw-cp-city">Kent</span>
            <span class="atw-cp-city">Tacoma</span>
            <span class="atw-cp-city">University Place</span>
            <span class="atw-cp-city">Spanaway</span>
            <span class="atw-cp-city">Orting</span>
            <span class="atw-cp-city">Buckley</span>
            <span class="atw-cp-city">Enumclaw</span>
            <span class="atw-cp-city">Milton</span>
            <span class="atw-cp-city">Edgewood</span>
            <span class="atw-cp-city">Federal Way</span>
            <span class="atw-cp-city">Fife</span>
          </div>

          <div class="atw-cp-area-note">
            Outside the marked area? Send us the address before booking. Availability depends on travel time, route, and the size of the job.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="atw-cp-faq-section">
    <div class="atw-cp-shell">
      <div class="atw-cp-kicker" data-reveal="up">Before You Contact Us</div>
      <h2 class="atw-cp-section-title" data-reveal="up">Quick <span class="atw-cp-gradient-text">Answers</span></h2>

      <div class="atw-cp-faq-list" data-reveal="up">
        <details class="atw-cp-faq-item" open>
          <summary>Do you have a physical shop?</summary>
          <div class="atw-cp-faq-answer">No. ATW Detailing is a mobile service. We come to your home, workplace, fleet lot, or another approved location inside our service area.</div>
        </details>
        <details class="atw-cp-faq-item">
          <summary>Do you bring your own equipment?</summary>
          <div class="atw-cp-faq-answer">Yes. We arrive with the equipment and products needed for the scheduled service. We will confirm any location-specific requirements before the appointment.</div>
        </details>
        <details class="atw-cp-faq-item">
          <summary>Where should I go for pricing?</summary>
          <div class="atw-cp-faq-answer">Use the online price estimate page for a starting price. For unusual vehicles, commercial jobs, heavy contamination, or custom work, contact us directly.</div>
        </details>
        <details class="atw-cp-faq-item">
          <summary>Can you work at apartments or workplaces?</summary>
          <div class="atw-cp-faq-answer">Often, yes. The location needs enough safe working space and permission when required. Send us the address and a quick description before booking.</div>
        </details>
        <details class="atw-cp-faq-item">
          <summary>What happens if weather affects the appointment?</summary>
          <div class="atw-cp-faq-answer">If weather makes the scheduled work impractical or unsafe, we will contact you and arrange the next suitable time.</div>
        </details>
        <details class="atw-cp-faq-item">
          <summary>How do I change an existing appointment?</summary>
          <div class="atw-cp-faq-answer">Text or call {site.phoneDisplay} as soon as possible. We will help move the appointment to another available time.</div>
        </details>
      </div>
    </div>
  </section>

  <section class="atw-cp-final">
    <div class="atw-cp-shell" data-reveal="up">
      <h2>Ready to <span class="atw-cp-gradient-text">Get Started?</span></h2>
      <p>Text us with a question, check your estimated price, or book an available appointment online.</p>
      <div class="atw-cp-actions">
        <a class="atw-cp-btn atw-cp-btn-primary" href="sms:+12533867243">Text Us</a>
        <a class="atw-cp-btn atw-cp-btn-outline" href="/mobile-detailing-price-estimate/">Price Estimate</a>
        <a class="atw-cp-btn atw-cp-btn-outline" href={site.bookingUrl} target="_blank" rel="noopener">Book Online</a>
      </div>
    </div>
  </section>
</div>

<script>
(function () {
  const root = document.getElementById('atw-cp');
  if (!root || root.dataset.particlesInitialized === '1') return;
  root.dataset.particlesInitialized = '1';

  /* Lightweight particle background */
  const canvas = document.getElementById('atw-cp-canvas');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobileViewport = window.matchMedia('(max-width: 900px)').matches;

  // The full-page particle canvas is relatively expensive on mobile.
  // Keep the visual effect on desktop and use the existing CSS background on smaller screens.
  if (!canvas || reduceMotion || mobileViewport) return;

  const ctx = canvas.getContext('2d');
  let w = 0;
  let h = 0;
  let particles = [];
  let animationFrame = null;
  const colors = ['#17cfd6', '#c85be8', '#ff7a2a', '#ffffff'];

  function resizeCanvas() {
    w = Math.max(root.clientWidth, 1);
    h = Math.max(root.scrollHeight, 1);
    canvas.width = w;
    canvas.height = h;
    const count = Math.max(42, Math.min(84, Math.round(w / 18)));
    particles = Array.from({ length: count }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: Math.random() * 1.4 + .35,
      vx: (Math.random() - .5) * .18,
      vy: (Math.random() - .5) * .2 - .03,
      a: Math.random() * .36 + .08,
      c: colors[Math.floor(Math.random() * colors.length)]
    }));
  }

  function drawParticles() {
    ctx.clearRect(0, 0, w, h);
    particles.forEach((p) => {
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < -5) p.x = w + 5;
      if (p.x > w + 5) p.x = -5;
      if (p.y < -5) p.y = h + 5;
      if (p.y > h + 5) p.y = -5;
      ctx.globalAlpha = p.a;
      ctx.fillStyle = p.c;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
    });
    ctx.globalAlpha = 1;
    animationFrame = requestAnimationFrame(drawParticles);
  }

  resizeCanvas();
  drawParticles();
  window.addEventListener('resize', () => {
    clearTimeout(window.atwCpResizeTimer);
    window.atwCpResizeTimer = setTimeout(resizeCanvas, 180);
  });
  setTimeout(resizeCanvas, 1200);

  window.addEventListener('beforeunload', () => {
    if (animationFrame) cancelAnimationFrame(animationFrame);
  }, { once: true });

})();


const form = document.getElementById('atw-contact-form');
const status = document.getElementById('atw-contact-status');
const startedAt = document.getElementById('atw-contact-started-at');
const requestType = document.getElementById('contact-request-type');
const appointmentFields = document.getElementById('appointment-fields');
const commercialFields = document.getElementById('commercial-fields');
const appointmentNote = document.getElementById('appointment-note');
const message = document.getElementById('contact-message');
const messageLabel = document.getElementById('contact-message-label');
const phone = document.getElementById('contact-phone');
const vehicle = document.getElementById('contact-vehicle');
const service = document.getElementById('contact-service');
const cityZip = document.getElementById('contact-city-zip');
const preferredDate = document.getElementById('contact-preferred-date');
const preferredTime = document.getElementById('contact-preferred-time');
const secondDate = document.getElementById('contact-second-date');
const companyName = document.getElementById('contact-company-name');
const submitButton = form?.querySelector('button[type="submit"]');

if (startedAt instanceof HTMLInputElement) {
  startedAt.value = String(Date.now());
}

function setRequired(element, required) {
  if (
    element instanceof HTMLInputElement ||
    element instanceof HTMLSelectElement ||
    element instanceof HTMLTextAreaElement
  ) {
    element.required = required;
  }
}

function updateFormMode() {
  if (!(requestType instanceof HTMLSelectElement)) return;

  const type = requestType.value;
  const isAppointment = type === 'appointment';
  const isCommercial = type === 'commercial';
  const isQuestion = type === 'question';

  if (appointmentFields) appointmentFields.hidden = !isAppointment;
  if (commercialFields) commercialFields.hidden = !isCommercial;
  if (appointmentNote) appointmentNote.hidden = !isAppointment;

  setRequired(phone, isAppointment || isCommercial);
  setRequired(vehicle, isAppointment);
  setRequired(service, isAppointment);
  setRequired(cityZip, isAppointment);
  setRequired(preferredDate, isAppointment);
  setRequired(preferredTime, isAppointment);
  setRequired(companyName, isCommercial);
  setRequired(message, isQuestion || isCommercial);

  if (message instanceof HTMLTextAreaElement) {
    if (isAppointment) {
      message.placeholder = 'Anything we should know about the vehicle or service?';
    } else if (isCommercial) {
      message.placeholder = 'Tell us about your vehicles, service needs, locations, and preferred schedule.';
    } else {
      message.placeholder = 'How can we help?';
    }
  }

  if (messageLabel) {
    messageLabel.innerHTML =
      isAppointment
        ? 'Notes <span>Optional</span>'
        : isCommercial
          ? 'Tell Us What You Need'
          : 'Your Message';
  }

  if (submitButton instanceof HTMLButtonElement) {
    submitButton.textContent =
      isAppointment
        ? 'Request Appointment'
        : isCommercial
          ? 'Send Fleet Inquiry'
          : 'Send Message';
  }
}

if (requestType instanceof HTMLSelectElement) {
  requestType.addEventListener('change', updateFormMode);
}

if (preferredDate instanceof HTMLInputElement) {
  const today = new Date();
  const localToday = new Date(today.getTime() - today.getTimezoneOffset() * 60000)
    .toISOString()
    .slice(0, 10);

  preferredDate.min = localToday;

  if (secondDate instanceof HTMLInputElement) {
    secondDate.min = localToday;
  }
}

updateFormMode();

if (form instanceof HTMLFormElement && status) {
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.textContent = '';
    status.classList.remove('is-success', 'is-error');

    if (!form.reportValidity()) return;

    const activeType =
      requestType instanceof HTMLSelectElement
        ? requestType.value
        : 'question';

    const sendingLabel =
      activeType === 'appointment'
        ? 'Sending Request…'
        : activeType === 'commercial'
          ? 'Sending Inquiry…'
          : 'Sending…';

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
      submitButton.textContent = sendingLabel;
    }

    try {
      const payload = Object.fromEntries(new FormData(form).entries());

      const response = await fetch('https://forms.atwdetailing.com/contact.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data?.error || 'Could not send request.');
      }

      form.reset();

      if (startedAt instanceof HTMLInputElement) {
        startedAt.value = String(Date.now());
      }

      updateFormMode();

      status.textContent =
        activeType === 'appointment'
          ? 'Thanks — your request was sent. We’ll confirm availability with you.'
          : activeType === 'commercial'
            ? 'Thanks — your fleet inquiry was sent. We’ll get back to you soon.'
            : 'Thanks — your message was sent. We’ll get back to you soon.';

      status.classList.remove('is-error');
      status.classList.add('is-success');
    } catch (error) {
      status.textContent =
        error instanceof Error
          ? error.message
          : 'Could not send request. Please text or email us instead.';

      status.classList.remove('is-success');
      status.classList.add('is-error');
    } finally {
      updateFormMode();

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
      }
    }
  });
}
</script>
