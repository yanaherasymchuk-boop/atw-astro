---
import { site } from "../../data/site";
---

<section class="atw-final">

  <div class="atw-final-inner" data-reveal="up">

    <div class="atw-eyebrow">
      Interior + Exterior · One Appointment
    </div>

    <h2>
      Ready for a Full Detail?
    </h2>

    <p>
      Book the Full Package online or check your vehicle category and pricing first.
    </p>


    <div class="atw-btns">

      <a
        class="atw-btn atw-btn-cyan"
        href={site.bookingUrl}>
        Book Full Package →
      </a>

      <a
        class="atw-btn atw-btn-violet"
        href={site.quoteUrl}>
        Get Price Estimate →
      </a>

      <a
        class="atw-btn atw-btn-orange"
        href="/contact-us/">
        Contact Us →
      </a>

    </div>

  </div>

</section>

