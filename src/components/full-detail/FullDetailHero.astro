---
import { site } from "../../data/site";
---

<section class="atw-hero">

  <div class="atw-hero-inner">

    <div class="atw-hero-copy">

      <div class="atw-badge">
        Mobile Service · Bonney Lake, WA
      </div>

      <h1>
        Full Car Detailing<br>
        <span>Inside & Out</span>
      </h1>

      <p>
        Complete interior and exterior detailing in one mobile appointment.
        We come to your home or workplace with the equipment needed to clean,
        refresh and protect your vehicle.
      </p>

      <div class="atw-btns">

        <a
          class="atw-btn atw-btn-cyan"
          href={site.bookingUrl}>
          Book Full Detail →
        </a>

        <a
          class="atw-btn atw-btn-violet"
          href={site.quoteUrl}>
          Get Price Estimate →
        </a>

      </div>

      <div class="atw-hero-mini">
        <span>Interior + Exterior</span>
        <span>Mobile Service</span>
        <span>One Appointment</span>
      </div>

    </div>

  </div>

</section>

<div class="atw-trust">

  <div class="atw-trust-grid">

    <div class="atw-trust-item">
      <span class="atw-check">✓</span>
      Interior deep cleaning
    </div>

    <div class="atw-trust-item">
      <span class="atw-check">✓</span>
      Exterior hand wash & detailing
    </div>

    <div class="atw-trust-item">
      <span class="atw-check">✓</span>
      Paint sealant & UV protection
    </div>

    <div class="atw-trust-item">
      <span class="atw-check">✓</span>
      Mobile — we come to you
    </div>

  </div>

</div>

