---
import { site } from "../../data/site";
---

<section class="interior-final">
  <div class="interior-final__inner" data-reveal="scale">
    <div class="interior-final__eyebrow">
      Mobile Interior Detailing
    </div>

    <h2>
      Ready for a Cleaner Interior?
    </h2>

    <p>
      Book Interior Detailing online,
      check your vehicle price,
      or text photos if you are not sure whether
      the vehicle needs extraction or another custom treatment.
    </p>

    <div class="interior-final__buttons">
      <a
        class="interior-final__button interior-final__button--cyan"
        href={site.bookingUrl}
      >
        Book Interior Detail →
      </a>

      <a
        class="interior-final__button interior-final__button--violet"
        href="/mobile-detailing-price-estimate/"
      >
        Get Price Estimate →
      </a>
    </div>
  </div>
</section>

<style>
  .interior-final {
    position: relative;

    min-height: 430px;

    display: flex;
    align-items: center;

    text-align: center;

    overflow: hidden;

    background:
      linear-gradient(
        rgba(5, 6, 17, 0.80),
        rgba(5, 6, 17, 0.91)
      ),
      url("/media/interior/final-cta-background.webp")
      center / cover no-repeat;
  }

  .interior-final::before {
    content: "";

    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        circle at 50% 43%,
        rgba(8, 215, 223, 0.13),
        transparent 43%
      );

    pointer-events: none;
  }

  .interior-final__inner {
    position: relative;
    z-index: 2;

    width: min(820px, calc(100% - 40px));

    margin: 0 auto;
    padding: 72px 0;
  }

  .interior-final__eyebrow {
    margin-bottom: 14px;

    color: var(--color-cyan);

    font-size: 12px;
    font-weight: 900;
    letter-spacing: 3px;

    text-transform: uppercase;
  }

  .interior-final h2 {
    margin: 0 0 16px;

    color: #fff;

    font-size: clamp(36px, 5vw, 55px);
    line-height: 1.08;
    font-weight: 900;
  }

  .interior-final p {
    max-width: 700px;

    margin: 0 auto 27px;

    color: #d0d2de;

    font-size: 16px;
    line-height: 1.65;
  }

  .interior-final__buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;

    gap: 14px;
  }

  .interior-final__button {
    min-height: 50px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 28px;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-pill);

    color: #fff;

    font-size: 13px;
    font-weight: 900;

    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);

    transition:
      transform var(--transition-fast),
      filter var(--transition-fast);
  }

  .interior-final__button:hover {
    transform: translateY(-3px);
    filter: brightness(1.1);
  }

  .interior-final__button--cyan {
    color: #061218;

    background: linear-gradient(
      100deg,
      #0ce1df,
      #18c8d7,
      #20aeda
    );
  }

  .interior-final__button--violet {
    background: linear-gradient(
      105deg,
      #922bdd,
      #5e19dd,
      #2413c3
    );
  }

  @media (max-width: 600px) {
    .interior-final__inner {
      width: calc(100% - 28px);
    }

    .interior-final__buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .interior-final__button {
      width: 100%;
    }
  }
</style>
