<section class="interior-map section">
  <div class="container">
    <div class="interior-map__heading" data-reveal="up">
      <div class="interior-map__eyebrow">
        What's Included
      </div>

      <h2>
        Inside the <span>Interior Detail</span>
      </h2>

      <p>
        Hover or tap the highlighted areas to see
        what receives attention during a standard Interior Detail.
      </p>
    </div>

    <div class="interior-map__grid">
      <div class="interior-map__car">
        <img
          src="https://atwdetailing.com/wp-content/uploads/2026/08/interior-prototipe.png"
          alt="Interior detailing zones in a vehicle"
        />

        <button
          class="hotspot hotspot--front active"
          type="button"
          aria-label="Front seats"
          data-zone="front"
        ></button>

        <button
          class="hotspot hotspot--rear"
          type="button"
          aria-label="Rear seats"
          data-zone="rear"
        ></button>

        <button
          class="hotspot hotspot--dash"
          type="button"
          aria-label="Dashboard and console"
          data-zone="dash"
        ></button>

        <button
          class="hotspot hotspot--floor"
          type="button"
          aria-label="Carpets and mats"
          data-zone="floor"
        ></button>

        <button
          class="hotspot hotspot--cargo"
          type="button"
          aria-label="Cargo area"
          data-zone="cargo"
        ></button>
      </div>

      <div class="interior-map__copy" data-reveal="up">
        <div class="interior-map__eyebrow">
          Explore the Interior
        </div>

        <h3>
          Different areas need different cleaning
        </h3>

        <p>
          We don't treat every surface with the same product.
          Material, location and condition determine how each area is cleaned.
        </p>

        <div class="interior-map__details">
          <div
            class="interior-map__detail active"
            data-zone-panel="front"
          >
            <strong>Front Seats</strong>

            <span>
              Seats are thoroughly vacuumed and cleaned according to material.
              Leather receives appropriate surface cleaning.
              Fabric that needs deeper treatment can be extracted separately.
            </span>
          </div>

          <div
            class="interior-map__detail"
            data-zone-panel="rear"
          >
            <strong>Rear Seats</strong>

            <span>
              Rear seating, seams and surrounding areas are vacuumed and cleaned.
              Everyday crumbs, dust and normal family-use buildup
              are addressed as part of the Interior Detail.
            </span>
          </div>

          <div
            class="interior-map__detail"
            data-zone-panel="dash"
          >
            <strong>Dashboard &amp; Console</strong>

            <span>
              Dashboard, steering area, center console, cup holders,
              switches and high-touch surfaces are cleaned
              without leaving an unnecessarily greasy finish.
            </span>
          </div>

          <div
            class="interior-map__detail"
            data-zone-panel="floor"
          >
            <strong>Carpets &amp; Mats</strong>

            <span>
              Carpets and floor mats are thoroughly vacuumed and cleaned.
              Light spots are addressed when possible.
              Deeper fabric contamination may require extraction.
            </span>
          </div>

          <div
            class="interior-map__detail"
            data-zone-panel="cargo"
          >
            <strong>Cargo Area</strong>

            <span>
              The trunk or cargo area is vacuumed and cleaned
              as part of the Interior Detail, including normal dirt
              and debris in accessible areas.
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector(".interior-map");

  if (root) {
    const hotspots = root.querySelectorAll("[data-zone]");
    const panels = root.querySelectorAll("[data-zone-panel]");

    function activateZone(button) {
      const key = button.getAttribute("data-zone");

      hotspots.forEach((item) => {
        item.classList.remove("active");
      });

      panels.forEach((item) => {
        item.classList.remove("active");
      });

      button.classList.add("active");

      const panel = root.querySelector(
        `[data-zone-panel="${key}"]`
      );

      panel?.classList.add("active");
    }

    hotspots.forEach((button) => {
      button.addEventListener("mouseenter", () => {
        activateZone(button);
      });

      button.addEventListener("click", () => {
        activateZone(button);
      });
    });
  }
</script>

