<section class="interior-treatment section">
  <div class="container">
    <div class="interior-treatment__heading">
      <div class="interior-treatment__eyebrow" data-reveal="up">
        Choose the Right Level
      </div>

      <h2>
        Standard Detail or <span>Deeper Treatment?</span>
      </h2>

      <p>
        Most vehicles only need Interior Detailing.
        Extraction is for fabric that needs more than normal surface cleaning.
      </p>
    </div>

    <div class="interior-treatment__wrap"data-reveal="up"
style="--reveal-delay: 100ms;">
      <div class="interior-treatment__tabs" >
        <button
          class="interior-treatment__tab active"
          type="button"
          data-treatment="standard"
        >
          Standard Interior Detail
        </button>

        <button
          class="interior-treatment__tab"
          type="button"
          data-treatment="deep"
        >
          Extraction / Deeper Cleaning
        </button>
      </div>

      <div class="interior-treatment__body">
        <div
          class="interior-treatment__panel active"
          data-treatment-panel="standard"
        >
          <div>
            <div class="interior-treatment__eyebrow">
              Everyday Interior Buildup
            </div>

            <h3>For normal daily-use dirt</h3>

            <p>
              If the interior mainly has dust, crumbs,
              routine grime, light spots or normal buildup,
              standard Interior Detailing is usually the right service.
            </p>

            <ul class="interior-treatment__checklist">
              <li>Seats, carpets and mats vacuumed</li>
              <li>Dashboard, console and trim cleaned</li>
              <li>Door panels and high-touch surfaces cleaned</li>
              <li>Interior glass</li>
              <li>Light spot treatment as needed</li>
              <li>Light pet hair included</li>
            </ul>
          </div>

          <div class="interior-treatment__image">
            <img
              src="/media/interior/clean-interior-treatment.webp"
              alt="Clean vehicle interior"
              width="720"
              height="1280"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div
          class="interior-treatment__panel"
          data-treatment-panel="deep"
        >
          <div>
            <div class="interior-treatment__eyebrow">
              Extraction &amp; Targeted Work
            </div>

            <h3>When surface cleaning is not enough</h3>

            <p>
              Extraction is used when contamination has worked
              into fabric and requires deeper cleaning.
            </p>

            <ul class="interior-treatment__checklist">
              <li>Heavier or older fabric stains</li>
              <li>Soaked-in spills</li>
              <li>Deeper upholstery contamination</li>
              <li>Odor source soaked into fabric</li>
              <li>One seat or several seats can be quoted separately</li>
              <li>Steam is not our standard cleaning method</li>
            </ul>
          </div>

          <div class="interior-treatment__image">
            <img
              src="/media/interior/stained-upholstery.webp"
              alt="Stained fabric requiring extraction"
              width="1448"
              height="1086"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector(".interior-treatment");

  if (root) {
    const tabs = root.querySelectorAll("[data-treatment]");
    const panels = root.querySelectorAll("[data-treatment-panel]");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const key = tab.getAttribute("data-treatment");

        tabs.forEach((item) => {
          item.classList.remove("active");
        });

        panels.forEach((item) => {
          item.classList.remove("active");
        });

        tab.classList.add("active");

        const panel = root.querySelector(
          `[data-treatment-panel="${key}"]`
        );

        panel?.classList.add("active");
      });
    });
  }
</script>

