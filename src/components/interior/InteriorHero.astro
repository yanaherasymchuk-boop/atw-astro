---
import { site } from "../../data/site";
---

<section class="interior-hero">
  <div class="interior-hero__inner">
    <div class="interior-hero__copy">

      <div class="interior-hero__badge">
        Mobile Interior Detailing · Bonney Lake, WA
      </div>

      <h1>
        Interior Detailing<br />
        <span>That Goes Deeper</span>
      </h1>

      <p>
        Professional mobile interior cleaning for everyday dirt,
        dust, crumbs, light stains and buildup.
        When the vehicle needs more than a standard detail,
        deeper fabric extraction, stain treatment and pet hair removal
        are available too.
      </p>

      <div class="interior-hero__buttons">
        <a
          class="interior-btn interior-btn--cyan"
          href={site.bookingUrl}
        >
          Book Interior Detail →
        </a>

        <a
          class="interior-btn interior-btn--violet"
          href="/mobile-detailing-price-estimate/"
        >
          Get Price Estimate →
        </a>
      </div>

      <div class="interior-hero__mini">
        <span>From $200</span>
        <span>Mobile Service</span>
        <span>Extraction Available</span>
        <span>Pet Hair &amp; Stains</span>
      </div>

    </div>
  </div>
</section>

<style>
  .interior-hero {
    position: relative;

    min-height: 650px;

    display: flex;
    align-items: center;

    overflow: hidden;

    background:
      linear-gradient(
        90deg,
        rgba(4, 5, 15, 0.96) 0%,
        rgba(4, 5, 15, 0.88) 36%,
        rgba(4, 5, 15, 0.46) 67%,
        rgba(4, 5, 15, 0.26) 100%
      ),
      linear-gradient(
        0deg,
        rgba(7, 8, 20, 0.97),
        transparent 40%
      ),
      url("https://atwdetailing.com/wp-content/uploads/2026/08/hero_interior-scaled.jpg")
      center center / cover no-repeat;
  }

  .interior-hero::after {
    content: "";

    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        circle at 15% 35%,
        rgba(8, 215, 223, 0.13),
        transparent 33%
      ),
      radial-gradient(
        circle at 82% 80%,
        rgba(125, 35, 221, 0.14),
        transparent 36%
      );

    pointer-events: none;
  }

  .interior-hero__inner {
    position: relative;
    z-index: 2;

    width: min(1180px, calc(100% - 40px));

    margin: 0 auto;
    padding: 100px 0 110px;
  }

  .interior-hero__copy {
    max-width: 710px;

    animation:
      interiorHeroIn 0.9s
      cubic-bezier(0.22, 0.61, 0.36, 1)
      both;
  }

  @keyframes interiorHeroIn {
    from {
      opacity: 0;
      transform: translateY(30px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .interior-hero__badge {
    display: inline-flex;

    padding: 9px 17px;
    margin-bottom: 24px;

    border: 1px solid rgba(8, 215, 223, 0.65);
    border-radius: var(--radius-pill);

    background: rgba(6, 17, 29, 0.58);

    backdrop-filter: blur(8px);

    color: #e3feff;

    font-size: 11px;
    font-weight: 900;

    letter-spacing: 2px;
    line-height: 1.3;

    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 22px;

    color: #fff;

    font-size: clamp(44px, 6vw, 70px);
    line-height: 1.02;

    font-weight: 900;
    letter-spacing: -1.5px;
  }

  h1 span {
    background: linear-gradient(
      90deg,
      #12d7dc,
      #3888f7,
      #9150ef
    );

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;
  }

  p {
    max-width: 680px;

    margin: 0 0 30px;

    color: #d8dae8;

    font-size: 17px;
    line-height: 1.72;
  }

  .interior-hero__buttons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 14px;
  }

  .interior-btn {
    min-height: 50px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 28px;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-pill);

    color: #fff;

    font-size: 13px;
    font-weight: 900;

    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);

    transition:
      transform var(--transition-fast),
      filter var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .interior-btn:hover {
    transform: translateY(-3px);
    filter: brightness(1.1);
  }

  .interior-btn--cyan {
    color: #061218;

    background: linear-gradient(
      100deg,
      #0ce1df,
      #18c8d7,
      #20aeda
    );

    box-shadow: 0 12px 34px rgba(8, 215, 223, 0.2);
  }

  .interior-btn--violet {
    background: linear-gradient(
      105deg,
      #922bdd,
      #5e19dd,
      #2413c3
    );

    box-shadow: 0 12px 34px rgba(102, 28, 219, 0.2);
  }

  .interior-hero__mini {
    display: flex;
    flex-wrap: wrap;

    gap: 9px;

    margin-top: 26px;
  }

  .interior-hero__mini span {
    padding: 7px 12px;

    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: var(--radius-pill);

    background: rgba(4, 5, 15, 0.48);

    color: #d9dbea;

    font-size: 11px;
    font-weight: 800;

    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .interior-hero__mini span:hover {
    transform: translateY(-2px);

    border-color: rgba(8, 215, 223, 0.4);
    background: rgba(8, 215, 223, 0.08);
  }

  @media (max-width: 600px) {
    .interior-hero {
      min-height: 660px;
      background-position: 57% center;
    }

    .interior-hero__inner {
      width: calc(100% - 28px);
      padding: 76px 0 84px;
    }

    h1 {
      font-size: 42px;
    }

    .interior-hero__buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .interior-btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interior-hero__copy {
      animation: none;
    }
  }
</style>