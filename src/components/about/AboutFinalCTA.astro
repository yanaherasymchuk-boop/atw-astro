---
import { site } from "../../data/site";
---

<section class="ab5">
  <div class="ab5-line" aria-hidden="true"></div>

  <div class="ab5-inner" data-reveal="up">
    <span class="ab5-eyebrow">Ready to Book?</span>

    <h2 class="ab5-title">
      Give your car the care<br />
      <em>it actually deserves.</em>
    </h2>

    <p class="ab5-sub">
      Get an instant price estimate or book directly online. We'll handle the rest
      — showing up on time, with everything we need, and leaving your vehicle
      looking its best.
    </p>

    <div class="ab5-btns">
      <a href={site.quoteUrl} class="ab5-btn ab5-btn-primary">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Get a Price Estimate
      </a>

      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener"
        class="ab5-btn ab5-btn-outline"
      >
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        Book Online
      </a>
    </div>

    <p class="ab5-note">
      Mobile detailing based in Bonney Lake, WA · Serving Pierce County and surrounding areas
    </p>
  </div>
</section>
