---
import { site } from "../../data/site";

const primaryCities = ["Bonney Lake", "Puyallup", "Tacoma", "Auburn"];
const otherCities = [
  "Sumner",
  "Edgewood",
  "Milton",
  "Federal Way",
  "Fife",
  "Kent",
  "Enumclaw",
  "Buckley",
  "Orting",
  "Graham",
  "Lakewood",
  "Covington",
  "Maple Valley",
];
---

<section class="ab4">
  <div class="ab4-inner">
    <div class="ab4-top" data-reveal="up">
      <span class="ab4-eyebrow">Where We Work</span>
      <h2 class="ab4-title">Service Area</h2>
      <p class="ab4-sub">
        Based in Bonney Lake — serving Pierce County and surrounding areas within
        25 miles.
      </p>
    </div>

    <div class="ab4-wrap">
      <div class="ab4-box" data-reveal="left">
        <h3 class="ab4-box-title">Primary Service Areas</h3>

        <div class="ab4-cities">
          {primaryCities.map((city) => <span class="ab4-city main">{city}</span>)}
          {otherCities.map((city) => <span class="ab4-city">{city}</span>)}
        </div>
      </div>

      <div class="ab4-right" data-reveal="right">
        <div class="ab4-photo-wrap">
          <img
            src="/media/about/suv-after.webp"
            alt="Mobile detailing result by ATW Detailing in Bonney Lake, Washington"
            width="960"
            height="720"
            loading="lazy"
            decoding="async"
          />

          <div class="ab4-photo-badge">
            <span>After Detail</span>
            Mobile service at your door
          </div>
        </div>

        <div class="ab4-zip">
          <h3 class="ab4-zip-title">Don't see your city?</h3>
          <p class="ab4-zip-body">
            Send us your ZIP code — we'll confirm availability and give you a custom quote.
          </p>

          <div class="ab4-zip-links">
            <a href="sms:+12533867243" class="ab4-zip-link">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
              </svg>
              Text {site.phoneDisplay}
            </a>

            <a
              href={`mailto:${site.email}?subject=Service%20Area%20Question`}
              class="ab4-zip-link"
            >
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Email Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
