---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { site } from "../data/site";
import "../styles/blog.css";

const title = "Car Detailing Blog | Paint Care, Interior Tips & PNW Guides";
const description =
  "Practical car detailing guides about paint care, ceramic coating, interiors, odors, washing and Pacific Northwest driving conditions.";
const canonical = `${site.url}/blog/`;
const ogImage = `${site.url}/media/blog/gloss-reflection.webp`;

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${canonical}#blog`,
  url: canonical,
  name: "ATW Detailing Journal",
  description,
  inLanguage: "en-US",
  publisher: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt="Glossy vehicle paint featured in the ATW Detailing Journal"
>
  <JsonLd slot="head" data={blogSchema} />
<div class="atw-blog-hub">

  <canvas id="atwbDropletCanvas"></canvas>

  <div class="atwb-bg-glow"></div>


  <!-- HERO -->

