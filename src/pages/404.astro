---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Page Not Found | ATW Detailing"
  description="The page you were looking for could not be found."
  canonical={`${site.url}/404/`}
  noindex
>
  <section class="not-found">
    <div class="not-found-inner">
      <p class="eyebrow">404</p>
      <h1>Page Not Found</h1>
      <p>
        The page you’re looking for may have moved or no longer exists.
      </p>

      <div class="not-found-actions">
        <a class="primary" href="/">Back to Home</a>
        <a href="/services/">View Services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: 90px 24px;
    text-align: center;
  }

  .not-found-inner {
    max-width: 680px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-cyan);
    font-size: 18px;
    font-weight: 900;
    letter-spacing: .14em;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 8vw, 78px);
    line-height: 1;
  }

  .not-found-inner > p:not(.eyebrow) {
    margin: 22px auto 0;
    max-width: 540px;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .not-found-actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .not-found-actions a {
    min-height: 46px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-weight: 800;
  }

  .not-found-actions .primary {
    border-color: transparent;
    background: linear-gradient(135deg,#08d7df,#168cff 55%,#7457ff);
    color: white;
  }
</style>
