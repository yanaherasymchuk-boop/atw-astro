/* RANDOM GENERATOR */

function randomNumber(){

  seed =
    (
      seed * 9301 +
      49297
    )
    %
    233280;


  return (
    seed /
    233280
  );

}


function resetSeed(value){

  seed = value;

}


/* CANVAS SIZE */

function sizeCanvas(canvas){

  const rect =
    stage.getBoundingClientRect();


  const dpr =
    Math.min(
      window.devicePixelRatio || 1,
      2
    );


  canvas.width =
    Math.round(
      rect.width * dpr
    );


  canvas.height =
    Math.round(
      rect.height * dpr
    );


  canvas.style.width =
    rect.width + "px";


  canvas.style.height =
    rect.height + "px";


  canvas
    .getContext("2d")
    .setTransform(
      dpr,
      0,
      0,
      dpr,
      0,
      0
    );

}


function clearCanvas(ctx){

  const rect =
    stage.getBoundingClientRect();


  ctx.clearRect(
    0,
    0,
    rect.width,
    rect.height
  );

}


function roundedRect(
  ctx,
  x,
  y,
  width,
  height,
  radius
){

  ctx.beginPath();


  ctx.moveTo(
    x + radius,
    y
  );


  ctx.arcTo(
    x + width,
    y,
    x + width,
    y + height,
    radius
  );


  ctx.arcTo(
    x + width,
    y + height,
    x,
    y + height,
    radius
  );


  ctx.arcTo(
    x,
    y + height,
    x,
    y,
    radius
  );


  ctx.arcTo(
    x,
    y,
    x + width,
    y,
    radius
  );


  ctx.closePath();

}


/* =========================================================
   DRAW DARK GLOSSY DOOR
========================================================= */

function drawBasePanel(){

  const rect =
    stage.getBoundingClientRect();


  const w =
    rect.width;

  const h =
    rect.height;


  clearCanvas(
    ctxBase
  );


  /* background */

  const background =
    ctxBase.createLinearGradient(
      0,
      0,
      0,
      h
    );


  background.addColorStop(
    0,
    "#07101e"
  );


  background.addColorStop(
    1,
    "#0a1323"
  );


  ctxBase.fillStyle =
    background;


  ctxBase.fillRect(
    0,
    0,
    w,
    h
  );


  panel.x =
    w * .07;


  panel.y =
    h * .12;


  panel.w =
    w * .86;


  panel.h =
    h * .72;


  panel.r =
    30;


  roundedRect(
    ctxBase,
    panel.x,
    panel.y,
    panel.w,
    panel.h,
    panel.r
  );


  /* DARK METALLIC PAINT */

  const paint =
    ctxBase.createLinearGradient(
      panel.x,
      panel.y,
      panel.x + panel.w,
      panel.y + panel.h
    );


  paint.addColorStop(
    0,
    "#131b2a"
  );


  paint.addColorStop(
    .15,
    "#344159"
  );


  paint.addColorStop(
    .34,
    "#111a29"
  );


  paint.addColorStop(
    .53,
    "#35465e"
  );


  paint.addColorStop(
    .75,
    "#101827"
  );


  paint.addColorStop(
    1,
    "#3c4d66"
  );


  ctxBase.fillStyle =
    paint;


  ctxBase.fill();


  ctxBase.strokeStyle =
    "rgba(255,255,255,.13)";


  ctxBase.lineWidth =
    1.4;


  ctxBase.stroke();


  /* METALLIC TONE */

  const metallic =
    ctxBase.createLinearGradient(
      panel.x,
      panel.y,
      panel.x,
      panel.y + panel.h
    );


  metallic.addColorStop(
    0,
    "rgba(255,255,255,.11)"
  );


  metallic.addColorStop(
    .25,
    "rgba(255,255,255,.02)"
  );


  metallic.addColorStop(
    1,
    "rgba(255,255,255,.03)"
  );


  ctxBase.fillStyle =
    metallic;


  roundedRect(
    ctxBase,
    panel.x + 1,
    panel.y + 1,
    panel.w - 2,
    panel.h - 2,
    panel.r - 1
  );


  ctxBase.fill();

  /* SOFT UPPER GLOSS */

  const softGlow =
    ctxBase.createLinearGradient(
      0,
      panel.y,
      0,
      panel.y + panel.h * .16
    );

  softGlow.addColorStop(
    0,
    "rgba(255,255,255,.09)"
  );

  softGlow.addColorStop(
    .45,
    "rgba(255,255,255,.03)"
  );

  softGlow.addColorStop(
    1,
    "rgba(255,255,255,0)"
  );

  roundedRect(
    ctxBase,
    panel.x + 14,
    panel.y + 10,
    panel.w - 28,
    panel.h * .09,
    16
  );

  ctxBase.fillStyle =
    softGlow;

  ctxBase.fill();
 
  /* BODY REFLECTION */

  ctxBase.beginPath();


  ctxBase.moveTo(
    panel.x + panel.w * .12,
    panel.y + panel.h * .52
  );


  ctxBase.bezierCurveTo(

    panel.x + panel.w * .36,
    panel.y + panel.h * .46,

    panel.x + panel.w * .60,
    panel.y + panel.h * .44,

    panel.x + panel.w * .90,
    panel.y + panel.h * .58

  );


  ctxBase.strokeStyle =
    "rgba(185,210,255,.16)";


  ctxBase.lineWidth =
    2.5;


  ctxBase.stroke();


  /* DOOR GAP */

  ctxBase.beginPath();


  ctxBase.moveTo(
    panel.x + panel.w * .75,
    panel.y
  );


  ctxBase.lineTo(
    panel.x + panel.w * .75,
    panel.y + panel.h
  );


  ctxBase.strokeStyle =
    "rgba(94,118,151,.44)";


  ctxBase.lineWidth =
    2.2;


  ctxBase.stroke();


  /* HANDLE POCKET */

  roundedRect(

    ctxBase,

    panel.x + panel.w * .26,

    panel.y + panel.h * .24,

    panel.w * .28,

    panel.h * .18,

    26

  );


  ctxBase.fillStyle =
    "rgba(0,0,0,.20)";


  ctxBase.fill();


  /* HANDLE */

  roundedRect(

    ctxBase,

    panel.x + panel.w * .30,

    panel.y + panel.h * .29,

    panel.w * .22,

    panel.h * .07,

    16

  );


  const handle =
    ctxBase.createLinearGradient(
      panel.x,
      0,
      panel.x + panel.w,
      0
    );


  handle.addColorStop(
    0,
    "#f0f4fb"
  );


  handle.addColorStop(
    .5,
    "#cdd9ea"
  );


  handle.addColorStop(
    1,
    "#9eb0cc"
  );


  ctxBase.fillStyle =
    handle;


  ctxBase.fill();


  ctxBase.strokeStyle =
    "rgba(255,255,255,.25)";


  ctxBase.lineWidth =
    1;


  ctxBase.stroke();

}


/* CLIP DEFECTS INSIDE PANEL */

function clipPanel(ctx){

  ctx.save();


  roundedRect(
    ctx,
    panel.x,
    panel.y,
    panel.w,
    panel.h,
    panel.r
  );


  ctx.clip();

}


/* =========================================================
   HAZE
========================================================= */

function drawHaze(){

  clearCanvas(
    ctxHaze
  );


  clipPanel(
    ctxHaze
  );


  const hazeGradient =
    ctxHaze.createLinearGradient(
      0,
      panel.y,
      0,
      panel.y + panel.h
    );


  hazeGradient.addColorStop(
    0,
    "rgba(180,195,220,.14)"
  );


  hazeGradient.addColorStop(
    .4,
    "rgba(120,135,165,.11)"
  );


  hazeGradient.addColorStop(
    1,
    "rgba(80,95,125,.08)"
  );


  ctxHaze.fillStyle =
    hazeGradient;


  ctxHaze.fillRect(
    panel.x,
    panel.y,
    panel.w,
    panel.h
  );


  resetSeed(
    311
  );


  for(
    let i=0;
    i<140;
    i++
  ){

    const x =
      panel.x +
      randomNumber() *
      panel.w;


    const y =
      panel.y +
      randomNumber() *
      panel.h;


    const length =
      26 +
      randomNumber() * 70;


    ctxHaze.strokeStyle =
      "rgba(220,228,240,.035)";


    ctxHaze.lineWidth =
      1 +
      randomNumber() * 2;


    ctxHaze.beginPath();


    ctxHaze.moveTo(
      x,
      y
    );


    ctxHaze.lineTo(
      x + length,
      y +
      (
        -8 +
        randomNumber() * 16
      )
    );


    ctxHaze.stroke();

  }


  ctxHaze.restore();

}


/* =========================================================
   REALISTIC SWIRLS
========================================================= */

function drawSwirlCloud(
  ctx,
  density,
  alpha,
  startSeed
){

  clipPanel(
    ctx
  );


  resetSeed(
    startSeed
  );


  for(
    let i=0;
    i<density;
    i++
  ){

    const cx =
      panel.x +
      panel.w * .12 +
      randomNumber() *
      panel.w * .63;


    const cy =
      panel.y +
      panel.h * .10 +
      randomNumber() *
      panel.h * .48;


    const radius =
      10 +
      randomNumber() * 30;


    const start =
      randomNumber() *
      Math.PI;


    const end =
      start +
      (
        .60 +
        randomNumber() * .95
      ) *
      Math.PI;


    ctx.strokeStyle =
      "rgba(218,228,245," +
      (
        alpha *
        (
          .65 +
          randomNumber() * .45
        )
      )
      .toFixed(3)
      +
      ")";


    ctx.lineWidth =
      .6 +
      randomNumber() *
      1.15;


    ctx.beginPath();


    ctx.arc(
      cx,
      cy,
      radius,
      start,
      end
    );


    ctx.stroke();

  }


  /* MICRO LINES */

  resetSeed(
    startSeed + 77
  );


  for(
    let i=0;
    i<density*1.3;
    i++
  ){

    const x =
      panel.x +
      panel.w * .08 +
      randomNumber() *
      panel.w * .69;


    const y =
      panel.y +
      panel.h * .10 +
      randomNumber() *
      panel.h * .57;


    const length =
      9 +
      randomNumber() * 26;


    const angle =
      -.45 +
      randomNumber() * .90;


    ctx.strokeStyle =
      "rgba(226,234,248," +
      (
        alpha *
        (
          .30 +
          randomNumber() * .34
        )
      )
      .toFixed(3)
      +
      ")";


    ctx.lineWidth =
      .5 +
      randomNumber() *
      .75;


    ctx.beginPath();


    ctx.moveTo(
      x,
      y
    );


    ctx.lineTo(

      x +
      Math.cos(angle) *
      length,

      y +
      Math.sin(angle) *
      length

    );


    ctx.stroke();

  }


  ctx.restore();

}


/* =========================================================
   SCRATCH
========================================================= */

function drawScratch(
  ctx,
  deep
){

  clipPanel(
    ctx
  );


  ctx.beginPath();


  ctx.moveTo(

    panel.x +
    panel.w * .18,

    panel.y +
    panel.h * .58

  );


  ctx.bezierCurveTo(

    panel.x +
    panel.w * .36,

    panel.y +
    panel.h * .48,

    panel.x +
    panel.w * .56,

    panel.y +
    panel.h * .55,

    panel.x +
    panel.w * .74,

    panel.y +
    panel.h * .60

  );


  ctx.strokeStyle =
    deep
    ?
    "rgba(40,44,53,.98)"
    :
    "rgba(45,51,62,.82)";


  ctx.lineWidth =
    deep
    ?
    5.2
    :
    3;


  ctx.stroke();


  ctx.strokeStyle =
    deep
    ?
    "rgba(248,249,252,.90)"
    :
    "rgba(246,247,250,.73)";


  ctx.lineWidth =
    deep
    ?
    1.5
    :
    1;


  ctx.stroke();


  ctx.restore();

}


/* =========================================================
   CHIPS
========================================================= */

function drawChips(){

  clipPanel(
    ctxPermanent
  );


  const chips = [

    {
      x:
        panel.x +
        panel.w * .31,

      y:
        panel.y +
        panel.h * .45,

      r:18
    },

    {
      x:
        panel.x +
        panel.w * .52,

      y:
        panel.y +
        panel.h * .54,

      r:22
    },

    {
      x:
        panel.x +
        panel.w * .67,

      y:
        panel.y +
        panel.h * .39,

      r:15
    }

  ];


  chips.forEach(
    function(chip,index){

      resetSeed(
        901 +
        index * 7
      );


      ctxPermanent.beginPath();


      const points =
        8;


      for(
        let i=0;
        i<=points;
        i++
      ){

        const angle =
          (
            i /
            points
          )
          *
          Math.PI *
          2;


        const radius =
          chip.r *
          (
            .72 +
            randomNumber() *
            .38
          );


        const px =
          chip.x +
          Math.cos(angle) *
          radius;


        const py =
          chip.y +
          Math.sin(angle) *
          radius;


        if(i===0){

          ctxPermanent.moveTo(
            px,
            py
          );

        }
        else{

          ctxPermanent.lineTo(
            px,
            py
          );

        }

      }


      ctxPermanent.closePath();


      ctxPermanent.fillStyle =
        "#8d9aab";


      ctxPermanent.fill();


      /* INNER EXPOSED AREA */

      ctxPermanent.beginPath();


      ctxPermanent.arc(

        chip.x + 2,

        chip.y + 1,

        chip.r * .52,

        0,

        Math.PI * 2

      );


      ctxPermanent.fillStyle =
        "#4b5667";


      ctxPermanent.fill();

    }
  );


  ctxPermanent.restore();

}


/* =========================================================
   DRAW SELECTED DAMAGE
========================================================= */

function drawDamage(){

  clearCanvas(
    ctxEasy
  );

  clearCanvas(
    ctxHard
  );

  clearCanvas(
    ctxPermanent
  );


  drawHaze();


  if(
    damage ===
    "swirls"
  ){

    drawSwirlCloud(
      ctxEasy,
      48,
      .24,
      121
    );


    drawSwirlCloud(
      ctxHard,
      31,
      .28,
      221
    );

  }


  if(
    damage ===
    "light"
  ){

    drawSwirlCloud(
      ctxEasy,
      29,
      .17,
      131
    );


    drawSwirlCloud(
      ctxHard,
      17,
      .22,
      231
    );


    drawScratch(
      ctxHard,
      false
    );

  }


  if(
    damage ===
    "deep"
  ){

    drawSwirlCloud(
      ctxEasy,
      14,
      .12,
      141
    );


    drawScratch(
      ctxPermanent,
      true
    );

  }


  if(
    damage ===
    "missing"
  ){

    drawSwirlCloud(
      ctxEasy,
      13,
      .10,
      151
    );


    drawChips();

  }

}


/* =========================================================
   ERASE DEFECTS WITH POLISHER
========================================================= */

function eraseLayer(
  ctx,
  x,
  y,
  radius
){

  ctx.save();


  ctx.globalCompositeOperation =
    "destination-out";


  const gradient =
    ctx.createRadialGradient(
      x,
      y,
      0,
      x,
      y,
      radius
    );


  gradient.addColorStop(
    0,
    "rgba(0,0,0,1)"
  );


  gradient.addColorStop(
    .66,
    "rgba(0,0,0,.96)"
  );


  gradient.addColorStop(
    1,
    "rgba(0,0,0,0)"
  );


  ctx.fillStyle =
    gradient;


  ctx.beginPath();


  ctx.arc(
    x,
    y,
    radius,
    0,
    Math.PI * 2
  );


  ctx.fill();


  ctx.restore();

}


function polishAt(
  x,
  y
){

  eraseLayer(
    ctxHaze,
    x,
    y,
    58
  );


  eraseLayer(
    ctxEasy,
    x,
    y,
    52
  );


  if(
    step === 2
  ){

    eraseLayer(
      ctxHard,
      x,
      y,
      48
    );

  }

}


/* =========================================================
   POINTER
========================================================= */

function pointerPosition(e){

  const rect =
    stage.getBoundingClientRect();


  return {

    x:
      e.clientX -
      rect.left,

    y:
      e.clientY -
      rect.top

  };

}


function moveTools(e){

  const point =
    pointerPosition(e);


  spot.style.left =
    point.x + "px";


  spot.style.top =
    point.y + "px";


  polisher.style.left =
    point.x + "px";


  polisher.style.top =
    point.y + "px";


  spot.classList.add(
    "show"
  );


  polisher.classList.add(
    "show"
  );


  return point;

}


function hideTools(){

  spot.classList.remove(
    "show"
  );


  polisher.classList.remove(
    "show"
  );


  polisher.classList.remove(
    "polishing"
  );

}


stage.addEventListener(
  "pointerdown",
  function(e){

    dragging = true;


    stage.setPointerCapture(
      e.pointerId
    );


    polisher.classList.add(
      "polishing"
    );


    const point =
      moveTools(e);


    polishAt(
      point.x,
      point.y
    );

  }
);


stage.addEventListener(
  "pointermove",
  function(e){

    const point =
      moveTools(e);


    if(
      dragging
    ){

      polisher.classList.add(
        "polishing"
      );


      polishAt(
        point.x,
        point.y
      );

    }

  }
);


stage.addEventListener(
  "pointerup",
  function(){

    dragging = false;


    polisher.classList.remove(
      "polishing"
    );

  }
);


stage.addEventListener(
  "pointercancel",
  function(){

    dragging = false;


    polisher.classList.remove(
      "polishing"
    );

  }
);


stage.addEventListener(
  "pointerleave",
  function(){

    dragging = false;


    hideTools();

  }
);


stage.addEventListener(
  "pointerenter",
  function(e){

    moveTools(e);

  }
);


/* =========================================================
   RESULT MONITOR
========================================================= */

function updateSimulatorCopy(){

  const copy =
    copyData[damage];


  titleElement.textContent =
    copy.title;


  textElement.textContent =
    copy.text;


  statusElement.textContent =
    copy.status;


  statusElement.className =
    "atwps2-status " +
    copy.cls;


  const monitor =
    monitorData[damage][step];


  glossBar.style.width =
    monitor.g + "%";


  surfaceBar.style.width =
    monitor.s + "%";


  deepBar.style.width =
    monitor.d + "%";


  glossLabel.textContent =
    monitor.gl;


  surfaceLabel.textContent =
    monitor.sl;


  deepLabel.textContent =
    monitor.dl;


  summaryElement.textContent =
    monitor.msg;


  processLabel.textContent =
    step === 1
    ?
    "1-Step Polish"
    :
    "2-Step Polish";

}


function rebuildSimulator(){

  drawBasePanel();

  drawDamage();

  updateSimulatorCopy();

}


/* DAMAGE BUTTONS */

document
.querySelectorAll(
  "#atwps2DamageButtons [data-damage]"
)
.forEach(
  function(button){

    button.addEventListener(
      "click",
      function(){

        damage =
          button.dataset.damage;


        document
        .querySelectorAll(
          "#atwps2DamageButtons [data-damage]"
        )
        .forEach(
          function(item){

            item.classList.remove(
              "active"
            );

          }
        );


        button.classList.add(
          "active"
        );


        rebuildSimulator();

      }
    );

  }
);


/* STEP BUTTONS */

document
.querySelectorAll(
  "#atwps2StepButtons [data-step]"
)
.forEach(
  function(button){

    button.addEventListener(
      "click",
      function(){

        step =
          Number(
            button.dataset.step
          );


        document
        .querySelectorAll(
          "#atwps2StepButtons [data-step]"
        )
        .forEach(
          function(item){

            item.classList.remove(
              "active"
            );

          }
        );


        button.classList.add(
          "active"
        );


        rebuildSimulator();

      }
    );

  }
);


resetButton.addEventListener(
  "click",
  rebuildSimulator
);


/* INITIALIZE */

function initializeSimulator(){

  [
    base,
    haze,
    easy,
    hard,
    permanent
  ]
  .forEach(
    sizeCanvas
  );


  rebuildSimulator();

}


let simulatorResizeTimer;


window.addEventListener(
  "resize",
  function(){

    clearTimeout(
      simulatorResizeTimer
    );


    simulatorResizeTimer =
      setTimeout(
        initializeSimulator,
        150
      );

  }
);


initializeSimulator();

}

}


/* =========================================================
   BEFORE / AFTER
========================================================= */

const ba =
  document.getElementById(
    "atwpBA"
  );


const baAfter =
  document.getElementById(
    "atwpBAAfter"
  );


const baLine =
  document.getElementById(
    "atwpBALine"
  );


const baHandle =
  document.getElementById(
    "atwpBAHandle"
  );


if(
  ba &&
  baAfter &&
  baLine &&
  baHandle
){

  let draggingBA =
    false;


  function setBA(
    clientX
  ){

    const rect =
      ba.getBoundingClientRect();


    let percent =
      (
        (
          clientX -
          rect.left
        )
        /
        rect.width
      )
      *
      100;


    percent =
      Math.max(
        3,
        Math.min(
          97,
          percent
        )
      );


    baAfter.style.clipPath =
      "inset(0 0 0 " +
      percent +
      "%)";


    baLine.style.left =
      percent +
      "%";


    baHandle.style.left =
      percent +
      "%";

  }


  ba.addEventListener(
    "pointerdown",
    function(e){

      draggingBA =
        true;


      ba.setPointerCapture(
        e.pointerId
      );


      setBA(
        e.clientX
      );

    }
  );


  ba.addEventListener(
    "pointermove",
    function(e){

      if(
        draggingBA
      ){

        setBA(
          e.clientX
        );

      }

    }
  );


  ba.addEventListener(
    "pointerup",
    function(){

      draggingBA =
        false;

    }
  );


  ba.addEventListener(
    "pointercancel",
    function(){

      draggingBA =
        false;

    }
  );

}


/* =========================================================
   DETAILER OR PAINTER
========================================================= */

const painterButtons =
  document.querySelectorAll(
    ".atwp-problem"
  );


const painterImage =
  document.getElementById(
    "atwpPainterImage"
  );


const painterTitle =
  document.getElementById(
    "atwpPainterTitle"
  );


const painterText =
  document.getElementById(
    "atwpPainterText"
  );


const painterStatus =
  document.getElementById(
    "atwpPainterStatus"
  );


painterButtons
.forEach(
  function(button){

    button.addEventListener(
      "click",
      function(){

        painterButtons
        .forEach(
          function(item){

            item.classList.remove(
              "active"
            );

          }
        );


        button.classList.add(
          "active"
        );


        painterTitle.textContent =
          button.dataset.title;


        painterText.textContent =
          button.dataset.answer;


        painterStatus.textContent =
          button.dataset.status;


        painterImage.style.opacity =
          "0";


        setTimeout(
          function(){

            painterImage.src =
              button.dataset.image;


            painterImage.onload =
              function(){

                painterImage.style.opacity =
                  "1";

              };

          },
          140
        );

      }
    );

  }
);


/* =========================================================
   SCROLL REVEAL
========================================================= */

const revealItems =
  document.querySelectorAll(
    ".atwp-reveal"
  );


const reducedMotion =
  window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;


if(
  reducedMotion ||
  !(
    "IntersectionObserver"
    in window
  )
){

  revealItems.forEach(
    function(item){

      item.classList.add(
        "visible"
      );

    }
  );

}
else{

  const observer =
    new IntersectionObserver(
      function(entries){

        entries.forEach(
          function(entry){

            if(
              entry.isIntersecting
            ){

              entry.target
              .classList
              .add(
                "visible"
              );


              observer.unobserve(
                entry.target
              );

            }

          }
        );

      },
      {
        threshold:.10,
        rootMargin:
          "0px 0px -35px 0px"
      }
    );


  revealItems.forEach(
    function(item){

      observer.observe(
        item
      );

    }
  );

}


});
</script>
</BaseLayout>
