  const labelButtons =
    root.querySelectorAll(
      '.atwb03-range-labels button'
    );



  if(
    !compare ||
    !range
  ){
    return;
  }



  let value = 0;
  let dragging = false;



  /* =====================================================
     UPDATE VISUAL
  ===================================================== */

  function update(newValue){

    value =
      Math.max(
        0,
        Math.min(
          100,
          Number(newValue)
        )
      );


    range.value =
      value;


    compare.setAttribute(
      'aria-valuenow',
      Math.round(value)
    );


    /*
      0–50:
      reveal dirty image

      50–100:
      dirty remains fully visible,
      salt residue image reveals over it
    */


    let dirtyReveal;
    let saltReveal;


    if(value <= 50){

      dirtyReveal =
        value * 2;

      saltReveal =
        0;

    }

    else{

      dirtyReveal =
        100;

      saltReveal =
        (value - 50) * 2;

    }


    dirtyMask.style.clipPath =
      'inset(0 ' +
      (100 - dirtyReveal) +
      '% 0 0)';


    saltMask.style.clipPath =
      'inset(0 ' +
      (100 - saltReveal) +
      '% 0 0)';


    dragLine.style.left =
      value + '%';


    percent.textContent =
      Math.round(value) + '%';



    /* =================================================
       STATUS
    ================================================= */

    labelButtons.forEach(
      function(button){

        button.classList.remove(
          'active'
        );

      }
    );


    if(value < 27){

      stageLabel.textContent =
        'CLEAN';

      stageTitle.textContent =
        'Clean winter finish';

      stageText.textContent =
        'No visible winter road buildup.';

      if(labelButtons[0]){
        labelButtons[0]
          .classList.add('active');
      }

    }

    else if(value < 69){

      stageLabel.textContent =
        'ROAD FILM';

      stageTitle.textContent =
        'Road spray + ordinary grime';

      stageText.textContent =
        'Wet pavement, dirt and grit can build up across lower vehicle surfaces.';

      if(labelButtons[1]){
        labelButtons[1]
          .classList.add('active');
      }

    }

    else{

      stageLabel.textContent =
        'TREATED-ROAD RESIDUE';

      stageTitle.textContent =
        'Heavier visible winter residue';

      stageText.textContent =
        'An illustrative reference showing road film plus pale dried treatment residue.';

      if(labelButtons[2]){
        labelButtons[2]
          .classList.add('active');
      }

    }

  }



  /* =====================================================
     RANGE INPUT
  ===================================================== */

  range.addEventListener(
    'input',
    function(){

      update(
        range.value
      );

    }
  );



  /* =====================================================
     CLICKABLE LABELS
  ===================================================== */

  labelButtons.forEach(
    function(button){

      button.addEventListener(
        'click',
        function(){

          update(
            button.dataset.value
          );

        }
      );

    }
  );



  /* =====================================================
     STAGE POINTER POSITION
  ===================================================== */

  function pointerToValue(event){

    const rect =
      compare.getBoundingClientRect();


    const clientX =
      event.clientX;


    const relative =
      clientX -
      rect.left;


    return(
      relative /
      rect.width *
      100
    );

  }



  /* =====================================================
     POINTER DOWN
  ===================================================== */

  compare.addEventListener(
    'pointerdown',
    function(event){

      dragging = true;

      compare.setPointerCapture(
        event.pointerId
      );

      update(
        pointerToValue(event)
      );

    }
  );



  /* =====================================================
     POINTER MOVE
  ===================================================== */

  compare.addEventListener(
    'pointermove',
    function(event){

      if(!dragging){
        return;
      }


      update(
        pointerToValue(event)
      );

    }
  );



  /* =====================================================
     POINTER UP
  ===================================================== */

  compare.addEventListener(
    'pointerup',
    function(event){

      dragging = false;


      if(
        compare.hasPointerCapture(
          event.pointerId
        )
      ){

        compare.releasePointerCapture(
          event.pointerId
        );

      }

    }
  );


  compare.addEventListener(
    'pointercancel',
    function(){

      dragging = false;

    }
  );



  /* =====================================================
     KEYBOARD
  ===================================================== */

  compare.addEventListener(
    'keydown',
    function(event){

      if(
        event.key === 'ArrowRight'
      ){

        event.preventDefault();

        update(
          value + 5
        );

      }


      if(
        event.key === 'ArrowLeft'
      ){

        event.preventDefault();

        update(
          value - 5
        );

      }


      if(
        event.key === 'Home'
      ){

        event.preventDefault();

        update(0);

      }


      if(
        event.key === 'End'
      ){

        event.preventDefault();

        update(100);

      }

    }
  );



  /* INITIAL STATE */

  update(0);

})();

(function(){

  const root =
    document.getElementById(
      'atw-winter-block-05'
    );


  if(!root){
    return;
  }


  const myths =
    root.querySelectorAll(
      '.atwb05-myth'
    );



  myths.forEach(
    function(myth){

      myth.addEventListener(
        'click',
        function(){

          const isOpen =
            myth.classList.contains(
              'open'
            );


          /*
            Only one card open at a time.
          */

          myths.forEach(
            function(item){

              item.classList.remove(
                'open'
              );

              item.setAttribute(
                'aria-expanded',
                'false'
              );

            }
          );


          if(!isOpen){

            myth.classList.add(
              'open'
            );

            myth.setAttribute(
              'aria-expanded',
              'true'
            );

          }

        }
      );

    }
  );

})();
</script>

</BaseLayout>
