<script is:inline>
(function(){

  const root =
    document.getElementById(
      'atw-winter-block-01'
    );


  if(!root){
    return;
  }


  const truck =
    root.querySelector(
      '#atwb01Truck'
    );


  if(!truck){
    return;
  }


  let locked = false;



  function activate(){

    truck.classList.add(
      'is-active'
    );

  }



  function deactivate(){

    if(!locked){

      truck.classList.remove(
        'is-active'
      );

    }

  }



  /* desktop hover */

  truck.addEventListener(
    'mouseenter',
    activate
  );


  truck.addEventListener(
    'mouseleave',
    deactivate
  );



  /* click / tap */

  truck.addEventListener(
    'click',
    function(){

      locked = !locked;

      truck.classList.toggle(
        'is-active',
        locked
      );

    }
  );



  /* keyboard */

  truck.addEventListener(
    'keydown',
    function(event){

      if(
        event.key === 'Enter' ||
        event.key === ' '
      ){

        event.preventDefault();

        locked = !locked;

        truck.classList.toggle(
          'is-active',
          locked
        );

      }

    }
  );



  /* touch */

  if(
    window.matchMedia &&
    window.matchMedia(
      '(hover:none)'
    ).matches
  ){

    locked = true;

    activate();

  }

})();

(function(){

  const root =
    document.getElementById(
      'atw-winter-block-02'
    );


  if(!root){
    return;
  }


  const tabs =
    root.querySelectorAll(
      '.atwb02-tab'
    );


  const scene =
    root.querySelector(
      '#atwb02RoadScene'
    );


  const kicker =
    root.querySelector(
      '#atwb02Kicker'
    );


  const title =
    root.querySelector(
      '#atwb02Title'
    );


  const text =
    root.querySelector(
      '#atwb02Text'
    );


  const fact1 =
    root.querySelector(
      '#atwb02Fact1'
    );


  const fact2 =
    root.querySelector(
      '#atwb02Fact2'
    );


  const fact3 =
    root.querySelector(
      '#atwb02Fact3'
    );


  const badge =
    root.querySelector(
      '#atwb02SceneBadge'
    );


  const status =
    root.querySelector(
      '#atwb02SceneStatus'
    );



  const modes = {


    anti:{

      kicker:
        'ANTI-ICING',

      title:
        'Applied before freezing',

      text:
        'Liquid chloride treatment can be applied before snow or ice begins so frozen precipitation is less likely to bond tightly to the pavement.',

      fact1:
        'Can be used before visible snow.',

      fact2:
        'The pavement may still look mostly clear.',

      fact3:
        'Treated spray can still reach vehicles.',

      badge:
        'BEFORE FREEZING',

      status:
        'Liquid treatment on mostly bare pavement'

    },



    de:{

      kicker:
        'DE-ICING',

      title:
        'Used after snow or ice begins',

      text:
        'Salt-based deicing material can help loosen or break the bond between a thin layer of snow or ice and the road surface.',

      fact1:
        'Used after frozen material begins forming.',

      fact2:
        'Its job is different from pre-treatment.',

      fact3:
        'Meltwater can become part of winter road spray.',

      badge:
        'AFTER ICE OR SNOW',

      status:
        'Treatment works with frozen material already present'

    },



    traction:{

      kicker:
        'TRACTION',

      title:
        'Adds grip — not melting',

      text:
        'Sand or other abrasive material can improve tire traction in slick conditions, but it is not the same thing as a chemical deicer.',

      fact1:
        'Adds physical grip.',

      fact2:
        'Does not melt ice by itself.',

      fact3:
        'Grit can become part of winter road film.',

      badge:
        'TRACTION MATERIAL',

      status:
        'Abrasive material adds grip to the road surface'

    }

  };



  function changeMode(mode){

    const data =
      modes[mode];


    if(!data){
      return;
    }


    tabs.forEach(
      function(tab){

        tab.classList.toggle(
          'active',
          tab.dataset.mode === mode
        );

      }
    );


    scene.dataset.mode =
      mode;


    kicker.textContent =
      data.kicker;


    title.textContent =
      data.title;


    text.textContent =
      data.text;


    fact1.textContent =
      data.fact1;


    fact2.textContent =
      data.fact2;


    fact3.textContent =
      data.fact3;


    badge.textContent =
      data.badge;


    status.textContent =
      data.status;

  }



  tabs.forEach(
    function(tab){

      tab.addEventListener(
        'click',
        function(){

          changeMode(
            tab.dataset.mode
          );

        }
      );

    }
  );


  changeMode('anti');

})();

