---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { site } from "../data/site";
import "../styles/service-detail-pages.css";

const title = "Paint Correction Bonney Lake, WA | ATW Detailing";
const description = "Mobile paint correction in Bonney Lake, WA for swirl marks, haze, oxidation and light paint defects. 1-step polishing from $300 and 2-step correction from $500.";
const canonical = `${site.url}/paint-correction-bonney-lake/`;
const ogImage = `${site.url}/media/paint-correction/hero.webp`;
const smsHref = site.phoneHref.replace("tel:", "sms:");

const cities = ["Bonney Lake","Lake Tapps","Puyallup","Sumner","Tacoma","University Place","Federal Way","Auburn","Kent"];
const areaServed = cities.map((name) => ({"@type":"City",name,containedInPlace:{"@type":"State",name:"Washington"}}));
const faqs = [
  ["What is the difference between 1-step and 2-step correction?","A 1-step polish is mainly for gloss improvement and reduction of lighter defects. A 2-step correction is a more involved two-stage polishing process for stronger defect reduction. 2-Step Correction starts from $500 total for both stages."],
  ["Will paint correction remove all scratches?","Not always. Paint correction can improve many swirls, haze and light defects, but deeper scratches, etched damage or defects that go beyond a safe correction level may remain."],
  ["Can this scratch be polished out?","Light clear-coat scratches may improve with polishing. Deep scratches, rock chips and areas with missing paint require paint repair, which we do not provide."],
  ["How do I get an accurate quote?","The best way is to send photos. Paint correction pricing depends on vehicle size, paint condition, defect severity and the level of correction requested."],
  ["How are vehicles categorized for paint correction?","We use Sedan / Coupe / Compact, SUV / Crossover, Large SUV / Minivan / Pickup, and Van / Oversized. Van, oversized and commercial configurations require direct review."],
  ["Should I do ceramic coating after polishing?","If you want longer-term protection after the paint has been improved, ceramic coating is usually the next step."],
  ["Do I need to bring the vehicle to a shop?","No. ATW Detailing is mobile. We come to your home, workplace or another suitable location within our service area."]
];

const schema = {
  "@context":"https://schema.org",
  "@graph":[
    {"@type":"LocalBusiness","@id":`${site.url}/#business`,name:site.name,url:site.url,telephone:site.phoneHref.replace("tel:",""),email:site.email,image:ogImage,areaServed},
    {"@type":"Service","@id":`${canonical}#service`,name:"Mobile Paint Correction",serviceType:"Automotive paint correction and machine polishing",url:canonical,description,provider:{"@id":`${site.url}/#business`},areaServed},
    {"@type":"FAQPage","@id":`${canonical}#faq`,mainEntity:faqs.map(([question,answer])=>({"@type":"Question",name:question,acceptedAnswer:{"@type":"Answer",text:answer}}))}
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} ogImageAlt="Glossy vehicle finish after paint correction">
  <JsonLd slot="head" data={schema} />
  <link slot="head" rel="preload" href="/media/paint-correction/hero-960.webp" as="image" type="image/webp" media="(max-width: 650px)" fetchpriority="high" />
  <link slot="head" rel="preload" href="/media/paint-correction/hero.webp" as="image" type="image/webp" media="(min-width: 651px)" fetchpriority="high" />
  <meta slot="head" name="robots" content="index,follow,max-image-preview:large" />

  <div class="atw-detail-page atw-paint">
    <section class="atw-hero">
      <div class="atw-hero-inner">
        <div class="atw-hero-copy">
          <div class="atw-badge">Mobile Paint Correction · Bonney Lake, WA</div>
          <h1>Paint Correction &amp;<br /><span class="atw-gradient">Polishing in Bonney Lake, WA</span></h1>
          <p>Machine polishing to improve gloss and reduce swirl marks, haze, oxidation and light clear-coat defects — right in your driveway.</p>
          <div class="atw-btns">
            <a class="atw-btn atw-btn-cyan" href="/contact-us/">Request Paint Quote →</a>
            <a class="atw-btn atw-btn-violet" href={smsHref}>Text Photos for Review →</a>
          </div>
          <p>Paint correction is machine polishing — not touch-up paint, chip repair, repainting or bodywork.</p>
          <div class="atw-hero-mini">
            <span>1-Step from $300</span><span>2-Step from $500</span><span>Photos Recommended</span><span>Mobile Service</span>
          </div>
        </div>
      </div>
    </section>

    <div class="atw-trust">
      <div class="atw-trust-grid">
        <div class="atw-trust-item"><span class="atw-check">✓</span>Gloss & clarity improvement</div>
        <div class="atw-trust-item"><span class="atw-check">✓</span>Swirl mark reduction</div>
        <div class="atw-trust-item"><span class="atw-check">✓</span>1-step & 2-step options</div>
        <div class="atw-trust-item"><span class="atw-check">✓</span>Mobile review by photos</div>
      </div>
    </div>

    <section class="atw-section">
      <div class="atw-container atw-split">
        <div class="atw-visual" data-reveal="left">
          <img src="/media/paint-correction/scratches-macro.webp" alt="Swirl marks and paint defects visible on vehicle paint" loading="lazy" decoding="async" />
        </div>
        <div class="atw-copy" data-reveal="right">
          <div class="atw-eyebrow">What Paint Correction Does</div>
          <h2 class="atw-title">Washing Cleans the Surface.<br /><span>Polishing Improves the Finish.</span></h2>
          <p>Paint correction uses machine polishing to reduce defects in the clear coat and improve clarity, depth and gloss.</p>
          <ul class="atw-checklist">
            <li>Reduces swirl marks</li><li>Improves haze and oxidation</li><li>Can reduce light clear-coat scratches</li><li>Restores gloss and clarity</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="atw-section atw-section-dark">
      <div class="atw-container">
        <div class="atw-center" data-reveal="up">
          <div class="atw-eyebrow">Service Limits</div>
          <h2 class="atw-title">What Paint Correction <span>Cannot Repair</span></h2>
        </div>
        <div class="atw-card" data-reveal="scale">
          <ul class="atw-checklist">
            <li>Rock chips</li>
            <li>Missing paint</li>
            <li>Scratches through the clear coat</li>
            <li>Peeling or failing paint</li>
            <li>Areas that need touch-up paint or repainting</li>
          </ul>
          <p>We do not perform paint touch-up, chip repair, bodywork or repainting. If paint is missing, polishing cannot put color back.</p>
        </div>
      </div>
    </section>

    <section class="atw-section atw-section-dark">
      <div class="atw-container">
        <div class="atw-center" data-reveal="up">
          <div class="atw-eyebrow">Real Examples</div>
          <h2 class="atw-title">Real Issues. <span>Real Improvement.</span></h2>
          <p class="atw-lead">These examples show real paint-condition improvements. Water spots, mineral deposits, haze and similar defects may improve significantly, but deeper etching or damage can remain.</p>
        </div>
        <div class="atw-card-grid atw-grid-2">
          <article class="atw-card atw-result" data-reveal="scale">
            <div class="atw-result-head"><h3>Water Spots &amp; Mineral Deposits</h3><p>Polishing can improve or remove water-spot etching and mineral deposits when the damage is shallow enough in the clear coat. Deeper etching may remain.</p></div>
            <div class="atw-before-after">
              <div class="atw-shot"><img src="/media/paint-correction/water-spots-before.webp" alt="Light paint marks before polishing" loading="lazy" decoding="async" /><span class="atw-shot-tag">BEFORE</span></div>
              <div class="atw-shot"><img src="/media/paint-correction/water-spots-after.webp" alt="Vehicle paint after polishing light marks" loading="lazy" decoding="async" /><span class="atw-shot-tag">AFTER</span></div>
            </div>
          </article>
          <article class="atw-card atw-result" data-reveal="scale">
            <div class="atw-result-head"><h3>Finish Improvement</h3><p>Polishing can restore clarity and gloss when the finish looks dull, hazy or marked. Final results depend on the condition and depth of the defects.</p></div>
            <div class="atw-before-after">
              <div class="atw-shot"><img src="/media/paint-correction/dull-before.webp" alt="Vehicle finish before detailing and paint improvement" loading="lazy" decoding="async" /><span class="atw-shot-tag">BEFORE</span></div>
              <div class="atw-shot"><img src="/media/paint-correction/dull-after.webp" alt="Vehicle finish after detailing and paint improvement" loading="lazy" decoding="async" /><span class="atw-shot-tag">AFTER</span></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="atw-section">
      <div class="atw-container">
        <div class="atw-center" data-reveal="up">
          <div class="atw-eyebrow">Choose the Right Level</div>
          <h2 class="atw-title">1-Step Polish or <span>2-Step Correction?</span></h2>
          <p class="atw-lead">Not every vehicle needs the same level of work. Start with the result you want, then match the correction level to the paint condition.</p>
        </div>
        <div class="atw-card-grid atw-grid-2">
          <article class="atw-card featured" data-reveal="scale">
            <div class="atw-pill">Most common</div><h3>1-Step Paint Polish</h3>
            <p>Best for restoring gloss and reducing lighter swirl marks, haze and minor clear-coat defects.</p>
            <ul class="atw-checklist"><li>Improves gloss and clarity</li><li>Reduces light swirls and haze</li><li>Good fit for daily drivers</li></ul>
            <div class="atw-price">From $300 <small>starting price</small></div>
          </article>
          <article class="atw-card" data-reveal="scale">
            <div class="atw-pill">More correction</div><h3>2-Step Paint Correction</h3>
            <p>A more intensive correction process for heavier swirl marks, oxidation and more noticeable clear-coat defects.</p>
            <ul class="atw-checklist"><li>Higher level of paint correction</li><li>More time and labor involved</li><li>For more heavily marked paint</li></ul>
            <div class="atw-price">From $500 <small>starting price</small></div>
          </article>
        </div>
      </div>
    </section>

    <section class="atw-section">
      <div class="atw-container">
        <div class="atw-center" data-reveal="up">
          <div class="atw-eyebrow">Correction, Not Cover-Up</div>
          <h2 class="atw-title">Improve the Paint <span>Safely</span></h2>
          <p class="atw-lead">Our goal is to improve the paint through machine polishing, not simply hide defects with temporary fillers. Some defects can be significantly reduced or removed; deeper damage may remain if correcting it further would be unsafe for the clear coat.</p>
        </div>
      </div>
    </section>

    <section class="atw-section atw-section-dark">
      <div class="atw-container">
        <div class="atw-center" data-reveal="up">
          <div class="atw-eyebrow">Paint Correction Pricing</div>
          <h2 class="atw-title">Start With the <span>Correction Level</span></h2>
          <p class="atw-lead">Paint condition matters more than a simple size chart. We confirm the final quote based on the vehicle and actual paint condition.</p>
        </div>
        <div class="atw-pricing-wrap" data-reveal="scale">
          <div class="atw-price-main">
            <div><h3>Starting Prices</h3><p>Final pricing is confirmed after photos or direct review.</p></div>
            <div class="atw-prices">
              <div class="atw-price-box"><small>1-Step Paint Polish</small><strong>From $300</strong></div>
              <div class="atw-price-box"><small>2-Step Paint Correction</small><strong>From $500 total</strong></div>
            </div>
          </div>
          <div class="atw-pricing-note"><strong>Vehicle size reference:</strong> Sedan / Coupe / Compact · SUV / Crossover · Large SUV / Minivan / Pickup. Van / Oversized / Commercial vehicles require a custom quote.</div>
          <div class="atw-btns" style="margin-top:26px">
            <a class="atw-btn atw-btn-cyan" href={smsHref}>Text Photos for Review →</a>
            <a class="atw-btn atw-btn-violet" href="/contact-us/">Request Custom Quote →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="atw-section">
      <div class="atw-container">
        <div class="atw-center" data-reveal="up"><div class="atw-eyebrow">Need a Different Package?</div><h2 class="atw-title">Paint Improvement <span>Fits Into Larger Services Too</span></h2></div>
        <div class="atw-card-grid atw-grid-2">
          <a class="atw-related-card" href="/services/" data-reveal="left">
            <img src="/media/paint-correction/restore.webp" alt="Paint polishing included with Restore Package" loading="lazy" decoding="async" />
            <div class="atw-related-copy"><div class="atw-eyebrow">Full + Polish</div><h3>Restore Package</h3><p>Full Package with a one-step machine polish for vehicles that need interior, exterior and paint improvement.</p><span class="atw-text-link">Explore Services →</span></div>
          </a>
          <a class="atw-related-card" href="/ceramic-coating/" data-reveal="right">
            <img src="/media/paint-correction/ceramic-related.webp" alt="Ceramic coating protection on glossy paint" loading="lazy" decoding="async" />
            <div class="atw-related-copy"><div class="atw-eyebrow">Protection After Prep</div><h3>Ceramic Coating</h3><p>When you want longer-term protection after polishing, ceramic coating is the next step.</p><span class="atw-text-link">Explore Ceramic Coating →</span></div>
          </a>
        </div>
      </div>
    </section>

    <section class="atw-section atw-section-dark">
      <div class="atw-container atw-center" data-reveal="up">
        <div class="atw-eyebrow">Mobile Service · Bonney Lake</div>
        <h2 class="atw-title">Paint Correction <span>Near Bonney Lake</span></h2>
        <p class="atw-lead">ATW Detailing is based in Bonney Lake and provides mobile detailing and paint improvement throughout nearby Pierce County and South King County communities.</p>
        <div class="atw-cities">{cities.map((city) =>
          city === "Bonney Lake"
            ? <a class="atw-city" href="/bonney-lake-car-detailing/">{city}</a>
            : city === "Puyallup"
              ? <a class="atw-city" href="/puyallup-car-detailing/">{city}</a>
              : city === "Tacoma"
                ? <a class="atw-city" href="/tacoma-car-detailing/">{city}</a>
                : <span class="atw-city">{city}</span>
        )}</div>
        <div style="margin-top:28px"><a class="atw-text-link" href="/service-areas/">View All Service Areas →</a></div>
      </div>
    </section>

    <section class="atw-section">
      <div class="atw-container">
        <div class="atw-center" data-reveal="up"><div class="atw-eyebrow">Common Questions</div><h2 class="atw-title">Paint Correction <span>FAQ</span></h2></div>
        <div class="atw-faq">
          {faqs.map(([question,answer]) => <details data-reveal="scale"><summary>{question}</summary><div class="atw-faq-answer">{answer}</div></details>)}
        </div>
      </div>
    </section>

    <section class="atw-final">
      <div class="atw-final-inner" data-reveal="up">
        <div class="atw-eyebrow">Mobile Paint Correction</div><h2>Ready to Improve the Finish?</h2>
        <p>Send your year, make, model and several photos of the paint. We’ll recommend the right level of correction.</p>
        <div class="atw-btns"><a class="atw-btn atw-btn-cyan" href={smsHref}>Text Photos →</a><a class="atw-btn atw-btn-violet" href="/contact-us/">Request Quote →</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
