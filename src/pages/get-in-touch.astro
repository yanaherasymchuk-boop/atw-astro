---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import "../styles/get-in-touch.css";

const canonical = `${site.url}/get-in-touch`;
const smsHref = site.phoneHref.replace(/^tel:/, "sms:");
---

<BaseLayout
  title="Get in Touch | ATW Detailing"
  description="Quick links to pricing, booking, services and contact options for ATW Detailing & Paint Correction."
  canonical={canonical}
  noindex
>
  <section class="touch-page">
    <div class="touch-bg" aria-hidden="true">
      <span class="orb orb-a"></span>
      <span class="orb orb-b"></span>
      <span class="orb orb-c"></span>
      <span class="touch-grid"></span>
    </div>

    <canvas id="touch-particles" aria-hidden="true"></canvas>

    <div class="touch-inner">
      <div class="touch-logo">
        <img
          src="/media/global/get-in-touch-logo.webp"
          alt="ATW Detailing & Paint Correction"
          width="700"
          height="700"
        />
      </div>

      <header class="touch-hero">
        <div class="touch-badge">
          <span aria-hidden="true"></span>
          Mobile Detailing
        </div>

        <h1>
          <span>WE COME</span>
          <strong>TO YOU</strong>
        </h1>

        <p>Saw us working nearby? Let’s take care of your car next.</p>
      </header>

      <div class="touch-actions" aria-label="Quick actions">
        <a class="touch-action cyan" href={site.quoteUrl}>
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M20 13 13 20 4 11V4h7z"></path>
              <circle cx="8.5" cy="8.5" r="1.3"></circle>
              <path d="M15.2 8.6c-.6-.7-1.4-1-2.3-1-1.2 0-2 .6-2 1.5 0 2.4 4.3 1.1 4.3 3.8 0 1.1-.9 1.8-2.3 1.8-1.1 0-2-.4-2.7-1.1"></path>
            </svg>
          </span>
          <span>
            <b>GET A PRICE ESTIMATE</b>
            <small>Answer a few questions and get a personalized estimate</small>
          </span>
          <i aria-hidden="true">›</i>
        </a>

        <a
          class="touch-action purple"
          href={site.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 10h18"></path>
              <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"></path>
            </svg>
          </span>
          <span>
            <b>BOOK ONLINE</b>
            <small>Choose a service and pick a time that works for you</small>
          </span>
          <i aria-hidden="true">›</i>
        </a>

        <a class="touch-action pink" href={smsHref}>
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M21 15a4 4 0 0 1-4 4H8l-5 3v-7a4 4 0 0 1-1-2.6V7a4 4 0 0 1 4-4h11a4 4 0 0 1 4 4z"></path>
              <path d="M7 10h.01M12 10h.01M17 10h.01"></path>
            </svg>
          </span>
          <span>
            <b>TEXT US</b>
            <small>Quickest way to reach us · {site.phoneDisplay}</small>
          </span>
          <i aria-hidden="true">›</i>
        </a>

        <a class="touch-action blue" href="/services/">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M5 16l1.5-5h11l1.5 5"></path>
              <path d="M4 16h16v3H4z"></path>
              <path d="M6 19v2M18 19v2"></path>
              <circle cx="7.5" cy="17.5" r=".7"></circle>
              <circle cx="16.5" cy="17.5" r=".7"></circle>
              <path d="M8 11l1.2-3h5.6l1.2 3"></path>
            </svg>
          </span>
          <span>
            <b>VIEW SERVICES</b>
            <small>Explore detailing, polishing and protection options</small>
          </span>
          <i aria-hidden="true">›</i>
        </a>
      </div>

      <nav class="touch-socials" aria-label="Contact and social links">
        <a
          class="social-google"
          href="https://www.google.com/maps/place/ATW+Detailing+%26+Paint+Correction/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.1a4.4 4.4 0 0 1-1.9 2.9v2.5h3.1c1.8-1.7 2.7-4.1 2.7-7.2z"></path>
            <path d="M12 21c2.5 0 4.7-.8 6.3-2.3l-3.1-2.5c-.8.6-1.9.9-3.2.9-2.4 0-4.5-1.6-5.2-3.8H3.6v2.6A9.5 9.5 0 0 0 12 21z"></path>
            <path d="M6.8 13.3A5.7 5.7 0 0 1 6.5 12c0-.5.1-.9.3-1.3V8.1H3.6A9.4 9.4 0 0 0 2.5 12c0 1.5.4 2.8 1.1 3.9z"></path>
            <path d="M12 6.9c1.4 0 2.6.5 3.5 1.4l2.7-2.6C16.6 4.1 14.5 3 12 3 8.3 3 5 5.1 3.6 8.1l3.2 2.6C7.5 8.5 9.6 6.9 12 6.9z"></path>
          </svg>
          <span>Google<br />Reviews</span>
        </a>

        <a
          class="social-instagram"
          href="https://www.instagram.com/atw_detailing_wa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r=".8"></circle>
          </svg>
          <span>Instagram</span>
        </a>

        <a
          class="social-facebook"
          href="https://www.facebook.com/atwdetailingwa/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v6h4v-6h3.3l.7-4h-4V9c0-.7.3-1 1-1z"></path>
          </svg>
          <span>Facebook</span>
        </a>

        <a class="social-call" href={site.phoneHref}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"></path>
          </svg>
          <span>Call Us</span>
        </a>

        <a class="social-contact" href="/contact-us/">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
            <path d="m4 6 8 7 8-7"></path>
          </svg>
          <span>Contact<br />Us</span>
        </a>
      </nav>

      <div class="touch-trust">
        <div>
          <svg class="trust-mobile" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 15h13l3 3h2v-6l-3-5h-5"></path>
            <path d="M3 15V7h10v8"></path>
            <circle cx="7" cy="18" r="2"></circle>
            <circle cx="17" cy="18" r="2"></circle>
          </svg>
          <b>Mobile Service</b>
          <span>We bring our own water and power</span>
        </div>

        <div>
          <svg class="trust-insured" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3 20 6v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
          <b>Insured</b>
          <span>Professional mobile service</span>
        </div>

        <div>
          <svg class="trust-local" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0z"></path>
            <circle cx="12" cy="10" r="2"></circle>
          </svg>
          <b>Local</b>
          <span>Bonney Lake and surrounding areas</span>
        </div>
      </div>

      <p class="touch-note">ATW Detailing &amp; Paint Correction</p>
    </div>
  </section>



  <script>
    const canvas = document.getElementById("touch-particles");

    if (
      canvas instanceof HTMLCanvasElement &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      const ctx = canvas.getContext("2d");
      const mobile = window.matchMedia("(max-width: 700px)").matches;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      let width = 0;
      let height = 0;
      let particles = [];
      let lastFrame = 0;

      const colors = ["#0ad2d9", "#9b5de5", "#e31b96", "#168cff"];

      const resize = () => {
        width = canvas.clientWidth;
        height = canvas.clientHeight;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);

        const count = mobile ? 32 : 56;

        particles = Array.from({ length: count }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          r: 0.7 + Math.random() * 1.5,
          vx: (Math.random() - 0.5) * 0.16,
          vy: -0.08 - Math.random() * 0.2,
          alpha: 0.18 + Math.random() * 0.55,
          color: colors[Math.floor(Math.random() * colors.length)],
        }));
      };

      const draw = (time) => {
        requestAnimationFrame(draw);

        if (document.hidden || time - lastFrame < 33) return;
        lastFrame = time;

        ctx?.clearRect(0, 0, width, height);

        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;

          if (p.y < -10) {
            p.y = height + 10;
            p.x = Math.random() * width;
          }

          if (p.x < -10) p.x = width + 10;
          if (p.x > width + 10) p.x = -10;

          if (!ctx) continue;

          ctx.globalAlpha = p.alpha;
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        }

        if (ctx) ctx.globalAlpha = 1;
      };

      resize();
      window.addEventListener("resize", resize, { passive: true });
      requestAnimationFrame(draw);
    }
  </script>

</BaseLayout>
