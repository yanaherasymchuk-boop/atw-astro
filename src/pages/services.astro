---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { site } from "../data/site";
import "../styles/services.css";

const title = "Auto Detailing Services in Bonney Lake, WA | ATW Detailing";
const description =
  "Mobile auto detailing in Bonney Lake, WA: interior and exterior detailing, paint correction, ceramic coating, and service packages brought to your location.";
const canonical = `${site.url}/services/`;
const ogImage = `${site.url}/media/home/full-detailing.webp`;
const pricingUrl =
  "https://docs.google.com/spreadsheets/d/e/2PACX-1vQgGieb2t2xFbQw7otQeMNFOqdyg-ziMugcZeIYjEOPwN4lq-M4S6H1kZ6hXHfymBXoA44ni5nKrfO2/pubhtml?gid=62926598&single=true";

const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "en-US",
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@id": `${site.url}/#business` },
      primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
    },
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Mobile Auto Detailing Services",
      serviceType: "Mobile auto detailing",
      provider: { "@id": `${site.url}/#business` },
      areaServed: ["Bonney Lake", "Puyallup", "Tacoma", "Auburn", "Kent", "Federal Way"],
      url: canonical,
      description,
    },
  ],
};

const services = [
  {
    title: "Interior Detailing",
    href: "/interior-detailing/",
    image: "/media/services/interior-detailing.webp",
    alt: "Interior detailing service in Bonney Lake, WA",
    text: "Deep interior cleaning, vacuuming, plastics, vinyl, dash, leather care, interior glass, and carpet or fabric shampoo/agitation as needed.",
    price: "From $200",
  },
  {
    title: "Exterior Detailing",
    href: "/exterior-detailing/",
    image: "/media/services/exterior-detailing.webp",
    alt: "Exterior detailing service in Bonney Lake, WA",
    text: "Hand wash, decontamination, wheels and trim cleaning, plus paint sealant for a clean, protected finish.",
    price: "From $100",
  },
  {
    title: "Paint Correction",
    href: "/paint-correction-bonney-lake/",
    image: "/media/services/paint-correction.webp",
    alt: "Paint correction and polishing in Bonney Lake, WA",
    text: "Reduce swirl marks, light scratches, oxidation, and dullness to restore gloss and clarity.",
    price: "From $300",
  },
  {
    title: "Ceramic Coating",
    href: "/ceramic-coating/",
    image: "/media/services/ceramic-coating.webp",
    alt: "Ceramic coating service in Bonney Lake, WA",
    text: "Long-term hydrophobic protection against UV exposure, chemicals, road grime, and environmental contamination.",
    price: "From $850",
  },
];

const packages = [
  {
    badge: "Great choice",
    tone: "violet",
    title: "Full Detail",
    subtitle: "Interior + Exterior",
    features: [
      "Interior deep cleaning",
      "Carpet & fabric shampoo/agitation as needed",
      "Exterior wash & dry",
      "Wheels, tires & trim cleaning",
      "Paint sealant & UV protection",
    ],
    price: "$280",
  },
  {
    badge: "Most popular",
    tone: "cyan",
    featured: true,
    title: "Restore Package",
    subtitle: "Full Detail + 1-Step Polish",
    features: [
      "Everything in Full Detail",
      "1-step paint polishing",
      "Light swirl & scratch reduction",
      "Enhanced gloss & clarity",
    ],
    price: "$570",
  },
  {
    badge: "Best protection",
    tone: "orange",
    title: "Elite Package",
    subtitle: "Restore + Ceramic Coating",
    features: [
      "Everything in Restore Package",
      "Professional ceramic coating",
      "Long-term paint protection",
      "Gloss & hydrophobic performance",
    ],
    price: "$850",
  },
  {
    badge: "Exterior max shine",
    tone: "violet",
    title: "Outside Elite",
    subtitle: "Exterior + Polish + Ceramic",
    features: [
      "Exterior detailing",
      "1-step paint polishing",
      "Ceramic coating",
      "Long-term protection & shine",
    ],
    price: "$580",
  },
];

const matches = [
  {
    number: "01",
    prompt: "Your car is dirty and needs a reset",
    label: "Best match",
    service: "Interior or Exterior Detailing",
    href: "/interior-detailing/",
    tone: "cyan",
  },
  {
    number: "02",
    prompt: "You want protection that lasts through the season",
    label: "Best match",
    service: "Ceramic Coating",
    href: "/ceramic-coating/",
    tone: "orange",
  },
  {
    number: "03",
    prompt: "You notice swirl marks and dull paint",
    label: "Best match",
    service: "Paint Correction",
    href: "/paint-correction-bonney-lake/",
    tone: "blue",
  },
  {
    number: "04",
    prompt: "You want the full treatment, inside and out",
    label: "Best match",
    service: "Full or Elite Detail Package",
    href: site.quoteUrl,
    tone: "violet",
  },
];

const faq = [
  {
    q: "Can you detail any type of vehicle?",
    a: "Yes — sedans, SUVs, trucks, and vans. For oversized vehicles like large trucks or Sprinter vans, pricing may vary. Contact us for a custom quote.",
  },
  {
    q: "How often should I detail my car?",
    a: "For most daily drivers, an exterior detail every 2–3 months and a full interior detail every 4–6 months keeps the car in great shape. Ceramic coating can reduce maintenance between details.",
  },
  {
    q: "What's the difference between the Restore and Full Detail packages?",
    a: "Full Detail covers interior and exterior cleaning. Restore adds a single-stage polish to reduce light swirl marks and bring back gloss. If your paint looks dull or has visible swirls, Restore is the better fit.",
  },
  {
    q: "How do I prepare my car before the appointment?",
    a: "Just remove personal items from the interior. We handle the rest — there is no need to pre-wash the vehicle.",
  },
  {
    q: "Do I need paint correction before ceramic coating?",
    a: "It is not always required, but it is strongly recommended when the paint has visible swirls or scratches. Ceramic coating preserves the condition underneath, so correction first gives the best final result.",
  },
];

const cities = [
  "Bonney Lake",
  "Lake Tapps",
  "Puyallup",
  "Sumner",
  "Tacoma",
  "University Place",
  "Federal Way",
  "Auburn",
  "Kent",
  "Spanaway",
  "South Hill",
  "Orting",
  "Buckley",
  "Enumclaw",
  "Milton",
  "Edgewood",
  "Fife",
  "Graham",
  "Lakewood",
  "Covington",
  "Maple Valley",
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt="ATW Detailing mobile auto detailing services"
>
  <JsonLd slot="head" data={serviceSchema} />

  <main class="services-page">
    <section class="services-hero section">
      <div class="container-wide services-hero__inner" data-reveal="up">
        <p class="services-kicker">Mobile Detailing · Bonney Lake, WA</p>
        <h1>Professional car care <span>delivered to your door.</span></h1>
        <p class="services-lead">
          Interior, exterior, paint correction and ceramic coating — serving Bonney Lake,
          Puyallup, Tacoma and nearby Pierce & King County communities. We bring the equipment.
        </p>
      </div>
    </section>

    <section class="service-grid-section section" aria-labelledby="services-heading">
      <div class="container-wide">
        <div class="section-heading" data-reveal="up">
          <p class="section-label">Services</p>
          <h2 id="services-heading">Choose the care your vehicle needs</h2>
        </div>

        <div class="service-grid">
          {services.map((item, index) => (
            <article class="service-card" data-reveal="up" style={`--reveal-delay:${index * 70}ms`}>
              <a class="service-card__media" href={item.href} aria-label={`Learn more about ${item.title}`}>
                <img
                  src={item.image}
                  alt={item.alt}
                  width="900"
                  height="675"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="service-card__body">
                <div>
                  <h3><a href={item.href}>{item.title}</a></h3>
                  <p>{item.text}</p>
                </div>
                <div class="service-card__footer">
                  <strong>{item.price}</strong>
                  <a href={item.href}>Learn more <span aria-hidden="true">→</span></a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="service-grid__footer" data-reveal="up">
          <a class="button button--ghost" href={site.galleryUrl} target="_blank" rel="noopener">
            View our gallery <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="mobile-value section">
      <div class="container mobile-value__grid">
        <div data-reveal="left">
          <p class="section-label">Why ATW Detailing</p>
          <h2>Your car doesn't need to <span>sit at a shop.</span></h2>
          <p>
            We bring professional-grade detailing directly to your driveway or workplace. From a
            straightforward exterior refresh to paint polishing and long-term ceramic protection,
            the work happens where your vehicle already is.
          </p>
          <p>
            Every service is handled by hand with attention to the areas automated car washes miss.
          </p>
          <a class="button button--primary" href={site.quoteUrl}>Get a price estimate <span>→</span></a>
        </div>

        <div class="mobile-value__panel" data-reveal="right">
          <div><strong>25 mi</strong><span>Service radius from Bonney Lake</span></div>
          <div><strong>5.0 ★</strong><span>Google rating · 13 reviews</span></div>
          <div><strong>$1M</strong><span>General liability coverage</span></div>
          <div><strong>100%</strong><span>Eco-friendly · Vinyl & wrap safe</span></div>
        </div>
      </div>
    </section>

    <section class="packages-section section" aria-labelledby="packages-heading">
      <div class="container-wide">
        <div class="section-heading section-heading--center" data-reveal="up">
          <p class="section-label">Packages</p>
          <h2 id="packages-heading">Upgrade <span>& save</span></h2>
          <p>Combine services when you want a more complete reset, finish, or protection package.</p>
        </div>

        <div class="packages-grid">
          {packages.map((item, index) => (
            <article
              class:list={["package-card", item.featured && "package-card--featured", `tone-${item.tone}`]}
              data-reveal="up"
              style={`--reveal-delay:${index * 70}ms`}
            >
              <span class="package-card__badge">{item.badge}</span>
              <h3>{item.title}</h3>
              <p class="package-card__subtitle">{item.subtitle}</p>
              <ul>
                {item.features.map((feature) => <li>{feature}</li>)}
              </ul>
              <p class="package-card__price-label">Starting at</p>
              <p class="package-card__price">{item.price} <small>/ Sedan</small></p>
              <a class="package-card__button" href={site.quoteUrl}>Get estimate <span>→</span></a>
            </article>
          ))}
        </div>

        <div class="pricing-strip" data-reveal="up">
          <div>
            <span class="pricing-strip__eyebrow">Pricing</span>
            <h3>Need every service, add-on, and vehicle size?</h3>
            <p>Open the full pricing list in Google Sheets.</p>
          </div>
          <a href={pricingUrl} target="_blank" rel="noopener">View full pricing <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="service-match section" aria-labelledby="match-heading">
      <div class="container-wide">
        <div class="service-match__intro" data-reveal="up">
          <p class="section-label section-label--orange">Not sure where to start?</p>
          <h2 id="match-heading">Start with the problem, <span>not the package name.</span></h2>
          <p>Pick the situation that sounds most like your vehicle and jump to the closest match.</p>
        </div>

        <div class="match-grid">
          {matches.map((item, index) => (
            <a
              href={item.href}
              class:list={["match-card", `tone-${item.tone}`]}
              data-reveal="up"
              style={`--reveal-delay:${index * 65}ms`}
            >
              <span class="match-card__number">{item.number}</span>
              <p class="match-card__prompt">{item.prompt}</p>
              <div class="match-card__result">
                <span>{item.label}</span>
                <strong>{item.service}</strong>
              </div>
              <span class="match-card__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="faq-section section" aria-labelledby="faq-heading">
      <div class="container faq-grid">
        <div class="faq-intro" data-reveal="left">
          <p class="section-label">Common questions</p>
          <h2 id="faq-heading">About our services</h2>
          <p>Short answers to the questions customers usually ask before choosing a package.</p>
          <a class="text-link" href="/contact-us/">Still unsure? Contact us <span>→</span></a>
        </div>

        <div class="faq-list" data-reveal="right">
          {faq.map((item, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{item.q}<span aria-hidden="true">+</span></summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="areas-section section" aria-labelledby="areas-heading">
      <div class="container">
        <div class="section-heading section-heading--center" data-reveal="up">
          <p class="section-label">Where we work</p>
          <h2 id="areas-heading">Areas we serve</h2>
          <p>Based in Bonney Lake and serving nearby Pierce & South King County communities.</p>
        </div>

        <div class="areas-card" data-reveal="up">
          <div class="areas-card__grid">
            <div class="areas-list">
              {cities.map((city, index) => <span class:list={[index < 9 && "is-primary"]}>{city}</span>)}
            </div>

            <div class="areas-map">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d85435.4!2d-122.18!3d47.17!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x54906b0000000001%3A0x1!2sBonney+Lake%2C+WA!5e0!3m2!1sen!2sus!4v1"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="ATW Detailing service area map"
              ></iframe>
            </div>
          </div>

          <div class="areas-card__footer">
            <p>We bring water & equipment. Don't see your city? Text your ZIP and we'll confirm availability.</p>
            <a href={`sms:${site.phoneHref.replace("tel:", "")}`}>Text {site.phoneDisplay} <span>→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="services-cta section">
      <div class="container services-cta__inner" data-reveal="scale">
        <p class="section-label">Ready to book?</p>
        <h2>Ready to <span>transform</span> your vehicle?</h2>
        <p>Choose a service online or use the estimate form if you want help deciding first.</p>
        <div class="services-cta__buttons">
          <a class="button button--primary" href={site.bookingUrl} target="_blank" rel="noopener">Book mobile detailing</a>
          <a class="button button--ghost" href={site.quoteUrl}>Get a price estimate</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const cta = document.querySelector(".services-cta");

  if (cta && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const updateParallax = () => {
      const rect = cta.getBoundingClientRect();
      const viewport = window.innerHeight;

      if (rect.bottom > 0 && rect.top < viewport) {
        const progress = (viewport - rect.top) / (viewport + rect.height);
        const offset = (progress - 0.5) * 70;
        cta.style.setProperty("--cta-parallax", `${offset}px`);
      }
    };

    updateParallax();
    window.addEventListener("scroll", updateParallax, { passive: true });
  }
</script>
