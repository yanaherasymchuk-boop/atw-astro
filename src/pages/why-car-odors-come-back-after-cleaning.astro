<script is:inline>
document.addEventListener("DOMContentLoaded",function(){
  const reveals=document.querySelectorAll(".atw-reveal");
  if("IntersectionObserver" in window){
    const obs=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add("atw-visible");obs.unobserve(entry.target)}})},{threshold:.12,rootMargin:"0px 0px -6% 0px"});
    reveals.forEach(el=>obs.observe(el));
  }else{reveals.forEach(el=>el.classList.add("atw-visible"))}

  const mapData=[
    ["01","HVAC & cabin filter","If an odor appears mainly when the fan or A/C starts, the airflow system may be part of the problem. A contaminated cabin filter can matter, but replacing it cannot remove a source that is still in the carpet or seats."],
    ["02","Seat material & foam","A seat can look clean on the surface while liquid or organic residue has reached deeper material. When contamination reaches foam, access becomes more limited."],
    ["03","Carpet, backing & padding","Carpet is layered. Contamination can move through the visible fibers into backing or padding underneath, where ordinary surface cleaning may not reach it."],
    ["04","Cargo area & hidden cavities","Spills, moisture, debris or animal contamination can sit underneath liners or behind trim. A clean visible surface does not prove the hidden area is dry or clean."]
  ];
  document.querySelectorAll(".atw-hotspot").forEach(btn=>btn.addEventListener("click",()=>{const d=mapData[Number(btn.dataset.i)];document.getElementById("mapIndex").textContent=d[0];document.getElementById("mapTitle").textContent=d[1];document.getElementById("mapText").textContent=d[2]}));

  const range=document.getElementById("depthRange");
  if(range){
    const contamination=document.getElementById("contamination"),depthLine=document.getElementById("depthLine"),index=document.getElementById("depthIndex"),label=document.getElementById("depthLabel"),title=document.getElementById("depthTitle"),text=document.getElementById("depthText"),badge=document.getElementById("depthBadge"),floating=document.getElementById("depthFloat"),labels=document.querySelectorAll("[data-depth]");
    const active=name=>labels.forEach(x=>x.classList.toggle("is-active",x.dataset.depth===name));
    const update=()=>{const v=Number(range.value);floating.style.left=v+"%";if(v<34){contamination.style.height=(14+v*.17)+"%";depthLine.style.top=(24+v*.12)+"%";index.textContent="01";label.textContent="Surface";title.textContent="The contamination stays near the top.";text.textContent="Material-appropriate cleaning may be able to reach most of the affected area when contamination has not penetrated deeply.";badge.textContent=floating.textContent="Surface";active("surface")}else if(v<68){contamination.style.height=(22+(v-34)*.63)+"%";depthLine.style.top=(31+(v-34)*.53)+"%";index.textContent="02";label.textContent="Through the material";title.textContent="The source is no longer only on the surface.";text.textContent="Liquid and organic residue can move through upholstery or carpet layers. Deep cleaning or extraction may help where the material and construction allow it.";badge.textContent=floating.textContent="Fabric";active("fabric")}else{contamination.style.height=(43+(v-68)*.85)+"%";depthLine.style.top=(49+(v-68)*.72)+"%";index.textContent="03";label.textContent="Into the foam";title.textContent="Now access becomes the limitation.";text.textContent="Once contamination reaches deeper foam or padding, a clean surface does not prove that the source is gone. Some cases may require deeper access or material replacement.";badge.textContent=floating.textContent="Foam";active("foam")}};
    range.addEventListener("input",update);update();
  }

  const opts=document.querySelectorAll(".atw-return-option");
  opts.forEach(opt=>opt.addEventListener("click",()=>{opts.forEach(x=>x.classList.remove("is-active"));opt.classList.add("is-active");document.getElementById("returnNum").textContent=opt.dataset.number;document.getElementById("returnTag").textContent=opt.dataset.tag;document.getElementById("returnTitle").textContent=opt.dataset.title;document.getElementById("returnText").textContent=opt.dataset.text}));

  const faqItems=document.querySelectorAll(".atw-faq-item");
  faqItems.forEach(item=>{const button=item.querySelector(".atw-faq-item__button");button.addEventListener("click",()=>{const isOpen=item.classList.contains("is-open");faqItems.forEach(x=>{x.classList.remove("is-open");x.querySelector(".atw-faq-item__button").setAttribute("aria-expanded","false")});if(!isOpen){item.classList.add("is-open");button.setAttribute("aria-expanded","true")}})});
});
</script>
</BaseLayout>
