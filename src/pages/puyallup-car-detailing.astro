  <script is:inline>
    (() => {
      const profile = document.querySelector("[data-profile]");
      if (profile) {
        const selections = new Map();
        const groups = profile.querySelectorAll("[data-group]");
        const title = profile.querySelector("[data-result-title]");
        const copy = profile.querySelector("[data-result-copy]");
        const meter = profile.querySelector("[data-meter]");
        const cleaning = profile.querySelector("[data-cleaning]");
        const interior = profile.querySelector("[data-interior]");
        const protection = profile.querySelector("[data-protection]");

        groups.forEach((group) => {
          const groupName = group.getAttribute("data-group");
          group.querySelectorAll("button").forEach((button) => {
            button.setAttribute("aria-pressed", "false");

            button.addEventListener("click", () => {
              group.querySelectorAll("button").forEach((item) => {
                item.classList.remove("is-active");
                item.setAttribute("aria-pressed", "false");
              });

              button.classList.add("is-active");
              button.setAttribute("aria-pressed", "true");
              selections.set(groupName, Number(button.dataset.score));

              if (selections.size !== groups.length) return;

              const total = [...selections.values()].reduce((sum, value) => sum + value, 0);
              const percentage = Math.round(((total - 4) / 8) * 100);

              meter.style.width = `${Math.max(8, percentage)}%`;

              if (total <= 6) {
                title.textContent = "LIGHT / OCCASIONAL USE";
                copy.textContent =
                  "Your vehicle has a relatively light use pattern. Condition matters more than mileage alone.";
                cleaning.textContent = "Routine";
                interior.textContent = "As needed";
                protection.textContent = "Optional";
              } else if (total <= 9) {
                title.textContent = "REGULAR DAILY DRIVER";
                copy.textContent =
                  "Regular driving makes consistent interior and exterior upkeep more useful than waiting for heavy buildup.";
                cleaning.textContent = "Regular";
                interior.textContent = "Regular";
                protection.textContent = "Consider";
              } else {
                title.textContent = "HEAVY DAILY USE";
                copy.textContent =
                  "This vehicle spends a lot of time in active use. Cleaning frequency and easier long-term maintenance become more relevant.";
                cleaning.textContent = "Higher priority";
                interior.textContent = "Higher priority";
                protection.textContent = "Worth discussing";
              }
            });
          });
        });
      }

      const video = document.querySelector("[data-py-video]");
      const toggle = document.querySelector("[data-video-toggle]");

      if (video) {
        const source = video.querySelector("source[data-src]");

        const loadVideo = () => {
          if (!source || source.src) return;
          source.src = source.dataset.src;
          video.load();
        };

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              loadVideo();
              video.play().catch(() => {});
              observer.disconnect();
            });
          },
          { rootMargin: "250px 0px" }
        );

        observer.observe(video);

        if (toggle) {
          toggle.addEventListener("click", () => {
            loadVideo();

            if (video.paused) {
              video.play().then(() => {
                toggle.textContent = "Pause video";
              }).catch(() => {});
            } else {
              video.pause();
              toggle.textContent = "Play video";
            }
          });

          video.addEventListener("play", () => {
            toggle.textContent = "Pause video";
          });

          video.addEventListener("pause", () => {
            toggle.textContent = "Play video";
          });
        }
      }
    })();
  </script>
</BaseLayout>
